class QmdError(Exception):
    pass


def qmd_dir(d):
    """The disposable Markdown projection for one authoritative store."""
    path = os.path.join(d, "QMD")
    if os.path.lexists(path) and os.path.islink(path):
        raise QmdError("refusing symbolic-link projection at %s" % pretty(path))
    return path


def qmd_collection(d):
    """A stable, path-private name inside QMD's dedicated OptMem index."""
    path = os.path.normcase(os.path.realpath(os.path.abspath(d)))
    return "optmem-" + hashlib.sha256(path.encode("utf-8")).hexdigest()[:12]


def _qmd_run(args, timeout=120):
    """Run QMD through one narrow, non-shell adapter."""
    exe = shutil.which("qmd")
    if not exe:
        raise QmdError(
            "qmd is not installed (requires Node.js 22+; install with: "
            "npm install -g @tobilu/qmd)")
    env = dict(os.environ)
    env["NO_COLOR"] = "1"
    try:
        result = subprocess.run(
            [exe, "--index", QMD_INDEX] + list(args),
            shell=False, capture_output=True, text=True, encoding="utf-8",
            errors="replace", timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        raise QmdError("qmd timed out after %d seconds" % timeout)
    except OSError as e:
        raise QmdError("could not start qmd: %s" % (e.strerror or e))
    if result.returncode:
        detail = (result.stderr or result.stdout).strip()
        detail = "; ".join(line.strip() for line in detail.splitlines()
                           if line.strip())[:500]
        failure = detail or "exited with status %d" % result.returncode
        raise QmdError("%s failed: %s" % (pretty(exe), failure))
    return result.stdout.strip()


def _qmd_file(d, name):
    return os.path.join(qmd_dir(d), name)


def qmd_enabled(d):
    try:
        return os.path.isfile(_qmd_file(d, "enabled"))
    except QmdError:
        return False


def qmd_fallback(d):
    """Whether ordinary zero-result recall may escalate to semantic recall."""
    try:
        return os.path.isfile(_qmd_file(d, "fallback"))
    except QmdError:
        return False


def _qmd_write(path, data):
    if os.path.isdir(path):
        raise QmdError("projection path is a directory: %s" % pretty(path))
    _atomic_replace(path, data, os.path.lexists(path))


def _qmd_mark(d, name):
    os.makedirs(qmd_dir(d), exist_ok=True)
    _qmd_write(_qmd_file(d, name), b"1\n")


def _qmd_state(d):
    path = _qmd_file(d, "state")
    if not os.path.isfile(path) or os.path.islink(path):
        return None
    try:
        with open(path, encoding="utf-8") as f:
            state = json.load(f)
    except (OSError, ValueError):
        return None
    if (not isinstance(state, dict) or state.get("format") != 1 or
            state.get("segmentSize") != QMD_SEGMENT_SIZE or
            type(state.get("logRecords")) is not int or
            state["logRecords"] < 0):
        return None
    return state


_QMD_SEGMENT_RE = re.compile(r"^(\d{8})-(\d{8})\.md$")
_QMD_RESULT_RE = re.compile(
    r"(?:^|[/\\])(\d{8})-(\d{8})\.md(?:\?|$)")
_QMD_MASK = ("[0-9]" * 8) + "-" + ("[0-9]" * 8) + ".md"


def _qmd_segment_name(lo):
    return "%08d-%08d.md" % (lo, lo + QMD_SEGMENT_SIZE - 1)


def _qmd_projection_files(d):
    path = qmd_dir(d)
    if not os.path.isdir(path):
        return set()
    return {name for name in os.listdir(path)
            if _QMD_SEGMENT_RE.match(name)
            and os.path.isfile(os.path.join(path, name))
            and not os.path.islink(os.path.join(path, name))}


def _qmd_segment(source, lo, T):
    source.seek(lo * LOG_REC)
    entries = records(source.read(
        (min(lo + QMD_SEGMENT_SIZE, T) - lo) * LOG_REC))
    lines = ["#%d %s %s" % entry for entry in entries]
    return ("\n\n".join(lines) + ("\n" if lines else "")).encode("utf-8")


def _qmd_sync_projection(d):
    """Incrementally derive fixed Markdown segments from the raw log."""
    with locked(d):
        T = log_len(d)
        state = _qmd_state(d)
        old = state["logRecords"] if state else None
        expected = {_qmd_segment_name(lo)
                    for lo in range(0, T, QMD_SEGMENT_SIZE)}
        existing = _qmd_projection_files(d)
        changed = old != T or existing != expected
        if not changed:
            return False, T, len(expected)

        os.makedirs(qmd_dir(d), exist_ok=True)
        _qmd_mark(d, "dirty")
        rewrite_from = 0 if old is None else (
            min(old, T) // QMD_SEGMENT_SIZE) * QMD_SEGMENT_SIZE
        with open(log_path(d), "rb") as source:
            for lo in range(0, T, QMD_SEGMENT_SIZE):
                name = _qmd_segment_name(lo)
                if name not in existing or lo >= rewrite_from:
                    _qmd_write(
                        _qmd_file(d, name), _qmd_segment(source, lo, T))
        for name in existing - expected:
            os.unlink(_qmd_file(d, name))
        encoded = (json.dumps({
            "format": 1,
            "logRecords": T,
            "segmentSize": QMD_SEGMENT_SIZE,
        }, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
        _qmd_write(_qmd_file(d, "state"), encoded)
        return True, T, len(expected)


def _qmd_context(d):
    global_path = os.path.normcase(os.path.realpath(
        os.path.abspath(os.path.expanduser(GLOBAL))))
    this_path = os.path.normcase(os.path.realpath(os.path.abspath(d)))
    if this_path == global_path:
        return ("Global OptMem memory: durable user preferences and facts "
                "that apply across projects.")
    if os.environ.get("MEMORY_DIR"):
        return ("Explicit OptMem memory: durable decisions, constraints, "
                "preferences, and facts stored in this selected scope.")
    scope = project_scope()
    if scope["kind"] == "remote":
        label = scope["project"]
        return ("Project OptMem memory for repository %s: architecture "
                "decisions, commands, failed approaches, and "
                "repository-specific facts." % label)
    return ("Project OptMem memory: architecture decisions, commands, failed "
            "approaches, and repository-specific facts.")


def _qmd_collection_exists(d):
    name = qmd_collection(d)
    try:
        details = _qmd_run(["collection", "show", name], timeout=30)
        match = re.search(r"(?m)^\s*Path:\s*(.+?)\s*$", details)
        if not match:
            raise QmdError("qmd collection show returned no path for %s" % name)
        actual = os.path.normcase(os.path.realpath(
            os.path.abspath(os.path.expanduser(match.group(1)))))
        expected = os.path.normcase(os.path.realpath(
            os.path.abspath(qmd_dir(d))))
        if actual != expected:
            raise QmdError(
                "QMD collection %s points at %s, expected %s"
                % (name, pretty(actual), pretty(expected)))
        return True
    except QmdError as e:
        if "collection not found" in str(e).lower():
            return False
        raise


def _qmd_ensure_collection(d, context=True):
    name = qmd_collection(d)
    created = False
    if not _qmd_collection_exists(d):
        _qmd_run(["collection", "add", qmd_dir(d), "--name", name,
                  "--mask", _QMD_MASK], timeout=300)
        created = True
    if context and created:
        try:
            _qmd_run(["context", "add", "qmd://%s" % name, _qmd_context(d)])
        except QmdError:
            try:
                _qmd_run(["collection", "remove", name])
            except QmdError:
                pass
            raise
    return created


def _qmd_index_projection(d, verify=False):
    """Bring QMD up to date, retrying after any interrupted prior attempt.
    Explicit sync also asks QMD to verify hashes and pending embeddings."""
    changed, T, segments = _qmd_sync_projection(d)
    created = _qmd_ensure_collection(d)
    dirty = os.path.isfile(_qmd_file(d, "dirty"))
    if changed or created or dirty or verify:
        _qmd_run(["update"], timeout=300)
        _qmd_run(["embed", "-c", qmd_collection(d)], timeout=1800)
        try:
            os.unlink(_qmd_file(d, "dirty"))
        except FileNotFoundError:
            pass
    return T, segments


def _qmd_reset_projection(d):
    path = qmd_dir(d)
    if not os.path.isdir(path):
        return
    for name in os.listdir(path):
        if name in ("state", "dirty") or _QMD_SEGMENT_RE.match(name):
            target = os.path.join(path, name)
            if os.path.isdir(target) and not os.path.islink(target):
                raise QmdError("unexpected directory in projection: %s"
                               % pretty(target))
            os.unlink(target)


def _qmd_purge_projection(d):
    path = qmd_dir(d)
    if not os.path.lexists(path):
        return
    expected = os.path.normcase(os.path.abspath(os.path.join(d, "QMD")))
    actual = os.path.normcase(os.path.abspath(path))
    if actual != expected or os.path.islink(path):
        raise QmdError("refusing unsafe projection purge at %s" % pretty(path))
    shutil.rmtree(path)


def _qmd_remove_collection(d):
    try:
        if _qmd_collection_exists(d):
            _qmd_run(["collection", "remove", qmd_collection(d)])
        return None
    except QmdError as e:
        return str(e)


def _qmd_status(d, probe=True):
    exists = os.path.isdir(d)
    enabled = exists and qmd_enabled(d)
    projection = "not created"
    records = segments = 0
    dirty = False
    unsafe = os.path.islink(os.path.join(d, "QMD")) if exists else False
    if unsafe:
        projection = "unsafe symbolic link"
    elif exists and os.path.isdir(os.path.join(d, "QMD")):
        state = _qmd_state(d)
        records = log_len(d)
        expected = (records + QMD_SEGMENT_SIZE - 1) // QMD_SEGMENT_SIZE
        actual = len(_qmd_projection_files(d))
        dirty = os.path.isfile(_qmd_file(d, "dirty"))
        if state and state["logRecords"] == records and actual == expected:
            projection = "%s, %s in %s" % (
                "current" if not dirty else "current projection; index pending",
                plural(records, "memory"), plural(actual, "segment"))
        else:
            projection = "stale or incomplete"
        segments = actual

    executable = "not installed"
    collection = "%s (not checked)" % qmd_collection(d)
    registered = None
    if probe:
        try:
            executable = _qmd_run(["--version"], timeout=30) or "available"
        except QmdError as e:
            executable = "unavailable: %s" % e
            collection = "%s (unavailable)" % qmd_collection(d)
        else:
            try:
                registered = _qmd_collection_exists(d)
                collection = "%s (%s)" % (
                    qmd_collection(d),
                    "registered" if registered else "missing")
            except QmdError as e:
                collection = "%s (error: %s)" % (qmd_collection(d), e)
    embeddings = ("inactive" if not enabled else
                  "missing collection" if registered is False else
                  "pending sync" if dirty else
                  "unknown" if probe and registered is None else
                  "current (last OptMem sync)"
                  if projection.startswith("current") else "unknown")
    return {
        "executable": executable,
        "enabled": enabled,
        "fallback": qmd_fallback(d),
        "projection": projection,
        "collection": collection,
        "embeddings": embeddings,
        "records": records,
        "segments": segments,
    }


def cmd_qmd(d, args):
    if not args or args in (["help"], ["--help"], ["-h"]):
        print("""Optional QMD semantic recall (disabled by default, per scope).

Usage:
  %s qmd enable             enable the integration; indexing stays lazy
  %s qmd status             inspect the executable and derived index state
  %s qmd sync               update the projection, index, and embeddings now
  %s qmd rebuild            recreate the projection, collection, and embeddings
  %s qmd config [FALLBACK=on|off]
      Opt into semantic fallback after exact/FFF misses.
  %s qmd disable            unregister QMD but keep the disposable projection
  %s qmd disable --purge    also remove the disposable projection

Recall by meaning with:
  %s recall --semantic "<meaning>"
  %s recall --semantic --fast "<meaning>"   skip reranking

LOG.txt remains authoritative. note and nap never use QMD; wake only reports
whether semantic recall is enabled."""
              % (ME, ME, ME, ME, ME, ME, ME, ME, ME))
        return
    if args[0] not in ("enable", "status", "sync", "rebuild", "config",
                       "disable"):
        die("Unknown QMD command: %s.\nRun: %s qmd help" % (args[0], ME))
    command, rest = args[0], args[1:]
    if command == "status":
        if rest:
            die("usage: %s qmd status" % ME)
        state = _qmd_status(d)
        print("OptMem QMD")
        print("  QMD executable:  %s" % state["executable"])
        print("  Integration:     %s" %
              ("enabled" if state["enabled"] else "disabled"))
        print("  Fallback:        %s" % (
            "on" if state["fallback"] and state["enabled"] else
            "on (inactive while disabled)" if state["fallback"] else "off"))
        print("  Projection:      %s" % state["projection"])
        print("  Collection:      %s" % state["collection"])
        print("  Embeddings:      %s" % state["embeddings"])
        if "unavailable:" in state["executable"]:
            print("  Exact/FFF recall remains available.")
            print("  Repair/remove the QMD launcher shown above, then install with:")
            print("    npm install -g @tobilu/qmd  (Node.js 22+)")
        return
    if command == "enable":
        if rest:
            die("usage: %s qmd enable" % ME)
        was_enabled = qmd_enabled(d)
        had_projection = os.path.isdir(qmd_dir(d))
        created = False
        try:
            _qmd_run(["--version"], timeout=30)
            _qmd_sync_projection(d)
            created = _qmd_ensure_collection(d)
            if not created:
                _qmd_run(["context", "add",
                          "qmd://%s" % qmd_collection(d), _qmd_context(d)])
            if created:
                _qmd_mark(d, "dirty")
            _qmd_mark(d, "enabled")
        except QmdError as e:
            if not was_enabled and not had_projection:
                if created:
                    _qmd_remove_collection(d)
                try:
                    _qmd_purge_projection(d)
                except QmdError:
                    pass
            die("Could not enable QMD: %s.\n"
                "No OptMem memory was changed." % e)
        print("QMD semantic recall is enabled for %s." % pretty(d))
        print("The first semantic recall will update and embed the projection.")
        return
    if command == "config":
        if len(rest) > 1:
            die("usage: %s qmd config [FALLBACK=on|off]" % ME)
        if rest:
            key, separator, value = rest[0].partition("=")
            if (not separator or key.strip().upper() != "FALLBACK" or
                    value.strip().lower() not in ("on", "off")):
                die("usage: %s qmd config [FALLBACK=on|off]" % ME)
            enabled = value.strip().lower() == "on"
            if enabled and not qmd_enabled(d):
                die("QMD fallback requires an enabled integration.\n"
                    "Run: %s qmd enable" % ME)
            if enabled:
                _qmd_mark(d, "fallback")
            else:
                try:
                    os.unlink(_qmd_file(d, "fallback"))
                except FileNotFoundError:
                    pass
                except QmdError as e:
                    die("Could not update QMD fallback: %s." % e)
        active = qmd_fallback(d)
        print("FALLBACK=%s" % ("on" if active else "off"))
        print("Ordinary zero-result recall %s semantic retrieval." %
              ("may escalate to" if active else "will not invoke"))
        return
    if command == "sync":
        if rest:
            die("usage: %s qmd sync" % ME)
        if not qmd_enabled(d):
            die("QMD is not enabled for this memory. Run: %s qmd enable" % ME)
        try:
            records, segments = _qmd_index_projection(d, verify=True)
        except QmdError as e:
            die("Could not synchronize QMD: %s.\n"
                "Raw OptMem memory is intact; retry sync later." % e)
        print("QMD projection and embeddings are current for %s." % pretty(d))
        print("%s in %s." %
              (plural(records, "memory"), plural(segments, "segment")))
        return
    if command == "rebuild":
        if rest:
            die("usage: %s qmd rebuild" % ME)
        if not qmd_enabled(d):
            die("QMD is not enabled for this memory. Run: %s qmd enable" % ME)
        try:
            _qmd_run(["--version"], timeout=30)
            _qmd_reset_projection(d)
            _qmd_sync_projection(d)
            error = _qmd_remove_collection(d)
            if error:
                raise QmdError(error)
            _qmd_ensure_collection(d)
            _qmd_index_projection(d)
        except QmdError as e:
            die("Could not rebuild QMD: %s.\n"
                "Raw OptMem memory is intact; retry rebuild later." % e)
        print("Rebuilt QMD projection and embeddings for %s." % pretty(d))
        return

    if any(arg != "--purge" for arg in rest) or rest.count("--purge") > 1:
        die("usage: %s qmd disable [--purge]" % ME)
    purge = bool(rest)
    try:
        os.unlink(_qmd_file(d, "enabled"))
    except FileNotFoundError:
        pass
    except QmdError as e:
        die("Could not disable QMD: %s." % e)
    warning = _qmd_remove_collection(d)
    if purge:
        try:
            _qmd_purge_projection(d)
        except QmdError as e:
            die("QMD was disabled, but projection purge failed: %s." % e)
    print("QMD semantic recall is disabled for %s." % pretty(d))
    print("Removed the derived projection." if purge
          else "Kept the rebuildable projection; use --purge to remove it.")
    if warning:
        print("Could not remove the external QMD collection: %s" % warning)
    print("Raw OptMem memory was not changed.")


def cmd_redact(d, args):
    """The sole explicit exception to raw-log immutability."""
    force = "--force" in args
    values = [arg for arg in args if arg != "--force"]
    if len(values) != 1 or len(args) != len(values) + (1 if force else 0):
        die("usage: %s redact <id> --force" % ME)
    ident = require_memory(d, values[0])
    if not force:
        die("This permanently removes the text of #%d from LOG.txt and "
            "invalidates summaries derived from it.\n\nRun again with --force:\n"
            "  %s redact %d --force" % (ident, ME, ident))

    had_qmd = os.path.isdir(os.path.join(d, "QMD"))
    enabled = qmd_enabled(d)
    result = log_redact(d, ident)
    if result is None:
        die("No memory #%d." % ident)
    newly_redacted = result[3]

    total = log_len(d)
    warnings = []
    try:
        gone = tree_invalidate_memory(d, ident) if total >= 2 else []
    except OSError as e:
        gone = []
        warnings.append("summary invalidation: %s" % (e.strerror or e))
    if had_qmd:
        warning = _qmd_remove_collection(d)
        if warning:
            warnings.append("external QMD collection: " + warning)
        try:
            _qmd_reset_projection(d)
            if enabled:
                _qmd_index_projection(d, verify=True)
        except (QmdError, OSError) as e:
            warnings.append("QMD rebuild: " + str(e))

    if newly_redacted:
        print("Redacted #%d. Its ID and date are preserved." % ident)
    else:
        print("#%d was already redacted; rechecked its derived caches." % ident)
    if gone:
        print("Invalidated %s. Run: %s nap --batch 8"
              % (plural(len(gone), "summary"), ME))
    if warnings:
        print("Warning: the raw log is redacted, but cleanup needs attention:")
        for warning in warnings:
            print("  - %s" % warning)
        print("Do not use semantic recall until `%s qmd rebuild` succeeds." % ME)


def fff_recall(d, query, limit=None):
    """The strongest typo-tolerant matches from LOG.txt, or (None, reason)
    when the optional Python 3.10+ FFF binding is unavailable or failed."""
    try:
        from fff import FileFinder
    except Exception as e:
        return None, str(e)

    try:
        path = log_path(d)
        requested = min(max(limit or 100, 100), MAX_RECALL_LIMIT)
        # One FileFinder lives for this command: FFF improves match quality
        # here; a one-shot CLI cannot claim its long-lived warm-index speedup.
        with FileFinder(d, watch=False) as finder:
            if not finder.wait_for_scan_blocking(timeout_ms=5000):
                return None, "the FFF scan timed out"
            result = finder.grep(
                query, mode="fuzzy",
                max_file_size=max(os.path.getsize(path) + 1, LOG_REC),
                max_matches_per_file=max(512, requested),
                page_limit=requested)
    except Exception as e:
        return None, str(e)

    ranked = []
    for match in result.items:
        if os.path.basename(match.relative_path).lower() != "log.txt":
            continue
        line = match.line_content.rstrip()
        if re.match(r"^#\d+ \d{4}-\d{2}-\d{2} ", line):
            ranked.append((match.fuzzy_score or 0, match.line_number, line))
    ranked.sort(key=lambda hit: (hit[0], hit[1]), reverse=True)

    out, size = [], 0
    for _, _, line in ranked:
        n = len(line.encode()) + 1
        if out and size + n > PART_CHARS:
            break
        out.append(line)
        size += n
        if limit is not None and len(out) >= limit:
            break
    return out, None


def _number_option(name, value, low, high):
    if not value.isdigit() or not low <= int(value) <= high:
        die("%s must be a whole number from %d to %d, not '%s'."
            % (name, low, high, value))
    return int(value)


def _recall_args(args):
    fuzzy, semantic, fast = False, False, False
    limit, context, query, i = None, 0, [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            query.extend(args[i + 1:])
            break
        if arg == "--fuzzy":
            fuzzy = True
        elif arg == "--semantic":
            semantic = True
        elif arg == "--fast":
            fast = True
        elif arg in ("--limit", "--context"):
            if i + 1 >= len(args):
                die("%s needs a number." % arg)
            i += 1
            if arg == "--limit":
                limit = _number_option(
                    "--limit", args[i], 1, MAX_RECALL_LIMIT)
            else:
                context = _number_option(
                    "--context", args[i], 0, MAX_RECALL_CONTEXT)
        elif arg.startswith("--limit="):
            limit = _number_option(
                "--limit", arg.partition("=")[2], 1, MAX_RECALL_LIMIT)
        elif arg.startswith("--context="):
            context = _number_option(
                "--context", arg.partition("=")[2], 0, MAX_RECALL_CONTEXT)
        elif arg.startswith("--"):
            die("Unknown recall option: %s." % arg)
        else:
            query.append(arg)
        i += 1
    if len(query) != 1:
        die("usage: %s recall [--fuzzy|--semantic [--fast]] [--limit N] "
            "[--context N] <query>" % ME)
    if fuzzy and semantic:
        die("Use either --fuzzy or --semantic, not both.")
    if fast and not semantic:
        die("--fast requires --semantic.")
    if semantic and (limit is not None or context):
        die("--limit and --context apply to exact/FFF recall, not --semantic.")
    return fuzzy, semantic, fast, limit, context, query[0]


def _memory_id(line):
    match = re.match(r"^#(\d+) ", line)
    return int(match.group(1)) if match else None


def _context_output(d, matches, radius, ranked=False):
    """Render deduplicated neighboring raw memories, marking every match."""
    if not radius:
        return list(matches)
    hit_ids = {_memory_id(line) for line in matches}
    hit_ids.discard(None)
    T, ordered, seen = log_len(d), [], set()
    if ranked:
        for line in matches:
            center = _memory_id(line)
            if center is None:
                continue
            for i in range(max(0, center - radius),
                           min(T, center + radius + 1)):
                if i not in seen:
                    seen.add(i)
                    ordered.append(i)
    else:
        for center in hit_ids:
            seen.update(range(max(0, center - radius),
                              min(T, center + radius + 1)))
        ordered = sorted(seen)
    out = []
    for i in ordered:
        memory = log_get(d, i)
        out.append("%s #%d %s %s" %
                   (">" if i in hit_ids else " ", memory[0],
                    memory[1], memory[2]))
    return out


def _output_size(lines):
    return sum(len(line.encode()) + 1 for line in lines)


def _fit_context(d, matches, radius, ranked):
    """Drop least useful matches until their deduplicated context fits."""
    matches = deque(matches)
    original = len(matches)
    rendered = _context_output(d, matches, radius, ranked)
    while len(matches) > 1 and _output_size(rendered) > PART_CHARS:
        if ranked:
            matches.pop()       # weakest fuzzy match
        else:
            matches.popleft()   # oldest exact match
        rendered = _context_output(d, matches, radius, ranked)
    return list(matches), rendered, len(matches) < original


def _print_fuzzy(d, out, limit, context):
    selected = list(out[:limit] if limit is not None else out)
    selected, rendered, output_trimmed = _fit_context(
        d, selected, context, ranked=True)
    print("\n".join(rendered))
    detail = "FFF, strongest first"
    if context:
        detail += "; context deduplicated, matches marked >"
    if output_trimmed:
        detail += "; output capped"
    print("%s (%s)." % (plural(len(selected), "fuzzy match"), detail))


def _qmd_result_ids(item, lo, hi, T):
    """Candidate IDs only; their text is always reread from canonical LOG."""
    upper = min(hi + 1, T)
    ids = []
    material = " ".join(str(item.get(key, ""))
                        for key in ("snippet", "body"))
    for value in re.findall(r"(?m)#(\d+)\b", material):
        i = int(value)
        if lo <= i < upper and i not in ids:
            ids.append(i)
    if not ids and upper > lo:
        try:
            line = max(1, int(item.get("line", 1)))
        except (TypeError, ValueError):
            line = 1
        ids.append(min(upper - 1, lo + (line - 1) // 2))
    return ids[:QMD_MEMORIES_PER_SEGMENT]


def _print_semantic(d, query, fast=False):
    if not qmd_enabled(d):
        die("Semantic recall unavailable: QMD is not enabled for this "
            "memory.\nRun: %s qmd enable\n"
            "Exact and FFF fuzzy recall are still available." % ME)
    try:
        T, _ = _qmd_index_projection(d)
        qmd_args = [
            "query", query, "--format", "json", "-n",
            str(QMD_QUERY_SEGMENTS), "-c", qmd_collection(d),
        ]
        if fast:
            qmd_args.append("--no-rerank")
        raw = _qmd_run(qmd_args, timeout=660)
        payload = json.loads(raw or "[]")
    except (QmdError, ValueError) as e:
        die("Semantic recall failed: %s.\n"
            "Exact and FFF fuzzy recall are still available." % e)
    if isinstance(payload, dict):
        payload = payload.get("results")
    if not isinstance(payload, list):
        die("Semantic recall failed: qmd returned unexpected JSON.\n"
            "Exact and FFF fuzzy recall are still available.")

    blocks, memories, seen_ids, seen_blocks = [], 0, set(), set()
    for item in payload:
        if not isinstance(item, dict):
            continue
        match = _QMD_RESULT_RE.search(str(item.get("file", "")))
        if not match:
            continue
        lo, hi = map(int, match.groups())
        if (lo % QMD_SEGMENT_SIZE or
                hi != lo + QMD_SEGMENT_SIZE - 1 or lo >= T or
                (lo, hi) in seen_blocks):
            continue
        seen_blocks.add((lo, hi))
        try:
            score = float(item.get("score", 0))
        except (TypeError, ValueError):
            score = 0
        percent = round(max(0, min(100, score if score > 1 else score * 100)))
        lines = ["#%d-%d — QMD relevance %d%%" % (lo, hi, percent)]
        for i in _qmd_result_ids(item, lo, hi, T):
            if i in seen_ids:
                continue
            seen_ids.add(i)
            lines.append("#%d %s %s" % log_get(d, i))
            memories += 1
        if len(lines) > 1:
            blocks.append(lines)
        if len(blocks) >= QMD_QUERY_SEGMENTS:
            break
    if not blocks:
        print("No semantic match.")
        return
    global_path = os.path.normcase(os.path.realpath(
        os.path.abspath(os.path.expanduser(GLOBAL))))
    scope = ("selected" if os.environ.get("MEMORY_DIR") else
             "global" if os.path.normcase(os.path.realpath(
                 os.path.abspath(d))) == global_path else "project")
    mode = " (fast, no reranking)" if fast else ""
    print("Semantic matches in %s memory%s:\n" % (scope, mode))
    print("\n\n".join("\n".join(block) for block in blocks))
    print("\n%s from %s." % (
        plural(memories, "likely memory"), plural(len(blocks), "matching block")))


def cmd_recall(d, args):
    fuzzy, semantic, fast, limit, context, query = _recall_args(args)
    if semantic:
        _print_semantic(d, query, fast=fast)
        return
    if fuzzy:
        out, error = fff_recall(d, query, limit)
        if out is None:
            die("FFF fuzzy recall failed: %s.\nInstall on Python 3.10+ with: "
                "%s -m pip install fff-search" % (error, sys.executable))
        if not out:
            print("No fuzzy match.")
            return
        _print_fuzzy(d, out, limit, context)
        return
    try:
        pat = re.compile(query, re.I)
    except re.error as e:
        die("bad regex: %s" % e)
    # One pass, keeping only the newest matches that fit the cap `wake`
    # respects -- a vague regex matches the whole log, and the whole log does
    # not fit in a harness's output or in memory.
    hits, out, size = 0, deque(), 0
    limit_trimmed = output_trimmed = False
    for e in log_scan(d):
        line = "#%d %s %s" % e
        if not pat.search(line):
            continue
        hits += 1
        out.append(line)
        size += len(line.encode()) + 1
        while limit is not None and len(out) > limit:
            limit_trimmed = True
            size -= len(out.popleft().encode()) + 1
        while size > PART_CHARS:
            output_trimmed = True
            size -= len(out.popleft().encode()) + 1
    if not hits:
        fuzzy_out, _ = fff_recall(d, query, limit)
        if fuzzy_out:
            print("No exact match. FFF fuzzy matches, strongest first:")
            _print_fuzzy(d, fuzzy_out, limit, context)
            return
        if qmd_enabled(d) and qmd_fallback(d):
            if fuzzy_out is None:
                print("No exact match; FFF fuzzy recall was unavailable. "
                      "Trying QMD semantic fallback.")
            else:
                print("No exact or FFF fuzzy match. "
                      "Trying QMD semantic fallback.")
            if limit is not None or context:
                print("Semantic fallback uses its own bounded result budget; "
                      "--limit/--context apply only to exact and FFF recall.")
            _print_semantic(d, query)
            return
        print("No match.")
        return
    selected, rendered, context_trimmed = _fit_context(
        d, out, context, ranked=False)
    print("\n".join(rendered))
    if len(selected) < hits:
        reasons = []
        if limit_trimmed:
            reasons.append("--limit %d" % limit)
        if output_trimmed or context_trimmed:
            reasons.append("output cap")
        reason = " (%s)" % "; ".join(reasons) if reasons else ""
        print("Newest %d of %s%s. Narrow the regex or adjust --limit."
              % (len(selected), plural(hits, "match"), reason))
    else:
        print("%s." % plural(hits, "match"))
    if context:
        print("Context: up to %d %s on each side; matches marked >."
              % (context, "memory" if context == 1 else "memories"))


def cmd_zoom(d, args):
    """One node of the tree, opened: its two halves, each rendered as wake
    renders it -- a summary, or the raw memory once a half is single. The
    navigating intelligence is the agent's; the tool only reads."""
    depth, block, i = 1, [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--depth":
            if i + 1 >= len(args):
                die("--depth needs a number.")
            i += 1
            depth = _number_option(
                "--depth", args[i], 1, MAX_ZOOM_DEPTH)
        elif arg.startswith("--depth="):
            depth = _number_option(
                "--depth", arg.partition("=")[2], 1, MAX_ZOOM_DEPTH)
        elif arg.startswith("--"):
            die("Unknown zoom option: %s." % arg)
        else:
            block.append(arg)
        i += 1
    if len(block) != 1:
        die("usage: %s zoom [--depth N] <lo>-<hi>   # N from 1 to %d"
            % (ME, MAX_ZOOM_DEPTH))
    lo, hi = block_id(block[0])
    T = log_len(d)
    if lo >= T:
        die("#%s is beyond the memory: it holds %s. Run: %s wake"
            % (block[0], plural(T, "memory"), ME))
    lines = []

    def descend(a, b, remaining):
        if a >= T:
            return  # the future: no memories there yet
        if b - a == 1:
            lines.append("#%d %s %s" % log_get(d, a))
        elif remaining:
            mid = (a + b) // 2
            descend(a, mid, remaining - 1)
            descend(mid, b, remaining - 1)
        else:
            lines.append("#%d-%d %s" % (
                a, b - 1, tree_get(d, a, b) or "not compressed yet"))

    descend(lo, hi, depth)
    if _output_size(lines) > PART_CHARS or len(lines) > PART_LINES:
        die("Depth %d exceeds the output limit for #%s. Retry with "
            "--depth %d." % (depth, block[0], depth - 1))
    print("\n".join(lines))


def cmd_export(d, args):
    with_ids = "--with-ids" in args
    paths = [arg for arg in args if arg != "--with-ids"]
    if len(paths) > 1 or len(args) != len(paths) + (1 if with_ids else 0):
        die("usage: %s export [--with-ids] [file]" % ME)
    if not paths:
        for ident, date, text in log_scan(d):
            prefix = "#%d " % ident if with_ids else ""
            sys.stdout.write("%s%s %s\n" % (prefix, date, text))
        return
    target = os.path.abspath(os.path.expanduser(paths[0]))
    if os.path.isdir(target):
        die("Export destination is a directory: %s." % pretty(target))
    if (os.path.normcase(os.path.realpath(target)) ==
            os.path.normcase(os.path.realpath(log_path(d)))):
        die("Refusing to export over the authoritative LOG.txt.")
    os.makedirs(os.path.dirname(target), exist_ok=True)
    existing = os.path.lexists(target)
    mode = os.stat(target).st_mode if existing else None
    fd, temporary = tempfile.mkstemp(prefix=".optmem-export-", suffix=".tmp",
                                     dir=os.path.dirname(target))
    written = 0
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as output:
            for ident, date, text in log_scan(d):
                prefix = "#%d " % ident if with_ids else ""
                output.write("%s%s %s\n" % (prefix, date, text))
                written += 1
            output.flush()
            os.fsync(output.fileno())
        if mode is not None:
            os.chmod(temporary, mode)
        os.replace(temporary, target)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    print("Exported %s to %s%s."
          % (plural(written, "memory"), pretty(target),
             " with inspection IDs" if with_ids else ""))


def _parse_import(path):
    try:
        src = open(path, encoding="utf-8").read().splitlines()
    except UnicodeDecodeError:
        die("%s is not UTF-8 text. Convert it, then import again."
            % pretty(path))
    last, out = "0000-00-00", []
    amendments = retractions = invalid_refs = 0
    longest = 0
    for i, line in enumerate(src, 1):
        if not line.strip():
            continue
        date, _, text = line.partition(" ")
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date):
            die("line %d: expected 'YYYY-MM-DD <text>', got: %s" % (i, line))
        try:
            datetime.datetime.strptime(date, "%Y-%m-%d")
        except ValueError:
            die("line %d: %s is not a real date." % (i, date))
        if date < last:
            die("line %d: date %s precedes the previous memory (%s)."
                % (i, date, last))
        text = text.strip()
        if not text or len(text.encode()) > ENTRY_CHARS:
            die("line %d: %d bytes, limit %d."
                % (i, len(text.encode()), ENTRY_CHARS))
        lifecycle = _LIFECYCLE_REF.match(text)
        if lifecycle:
            target = int(lifecycle.group(2))
            if lifecycle.group(1) == "Amends":
                amendments += 1
            else:
                retractions += 1
            if target >= len(out):
                invalid_refs += 1
        out.append((date, text))
        longest = max(longest, len(text.encode()))
        last = date
    if not out:
        die("%s has no memories." % path)
    return out, {
        "first": out[0][0],
        "last": out[-1][0],
        "longest": longest,
        "amendments": amendments,
        "retractions": retractions,
        "invalid_refs": invalid_refs,
    }


def cmd_import(d, args):
    """Restore portable 'YYYY-MM-DD <text>' records into an empty store."""
    dry = "--dry-run" in args
    paths = [arg for arg in args if arg != "--dry-run"]
    if len(paths) != 1 or len(args) != 1 + (1 if dry else 0):
        die("usage: %s import [--dry-run] <file>" % ME)
    out, stats = _parse_import(paths[0])
    if stats["invalid_refs"]:
        die("Invalid OptMem import: %d amendment/retraction %s forward or "
            "outside the file."
            % (stats["invalid_refs"],
               "reference points" if stats["invalid_refs"] == 1
               else "references point"))
    existing = log_len(d) if os.path.isfile(log_path(d)) else 0
    if existing:
        die("Cannot import an OptMem history into a nonempty store.\n\n"
            "This store already contains %s.\n"
            "Import is for restoring or bootstrapping an empty store."
            % plural(existing, "memory"))
    if dry:
        print("Valid OptMem import")
        print("  Records:       %s" % format(len(out), ","))
        print("  First date:    %s" % stats["first"])
        print("  Last date:     %s" % stats["last"])
        print("  Longest entry: %d of %d bytes"
              % (stats["longest"], ENTRY_CHARS))
        print("  Amendments:    %d" % stats["amendments"])
        print("  Retractions:   %d" % stats["retractions"])
        print("  Invalid refs:  0")
        return
    if not log_import_empty(d, out):
        die("Cannot import an OptMem history into a nonempty store.\n\n"
            "Another writer added a memory during import preflight. Retry with "
            "an empty store.")
    print("Imported %s, #0 to #%d."
          % (plural(len(out), "memory"), len(out) - 1))
    n = pending_count(d, log_len(d))
    if n:
        print("%s pending. Run: %s nap --batch 8"
              % (plural(n, "compression"), ME))


def memory_status(d):
    """A read-only, human-friendly store summary for doctor."""
    if not os.path.isdir(d):
        return "not created"
    p = log_path(d)
    if os.path.islink(p):
        return "LOG.txt is a symbolic link"
    if not os.path.isfile(p):
        return "directory exists, but LOG.txt is missing"
    size = os.path.getsize(p)
    if size % LOG_REC:
        return "LOG.txt is corrupt (%d trailing bytes)" % (size % LOG_REC)
    return plural(size // LOG_REC, "memory")


