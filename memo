def _scope_identity_status(d):
    if SCOPE_GLOBAL or os.environ.get("MEMORY_DIR"):
        return "not applicable", None
    info = project_scope()
    current = info["identity"]
    stored = _read_scope_identity(d)
    if not os.path.isdir(d):
        return "not recorded (store not created)", None
    if stored is None and os.path.lexists(_scope_identity_path(d)):
        return "INVALID", "scope.json is malformed or unsafe"
    if stored is None:
        return "unrecorded legacy store", None
    if not _stored_identity_matches(stored, current):
        warning = ("store belongs to %s, but this checkout is %s"
                   % (stored["canonical"], current))
        return "COLLISION", warning
    return current, None


def _verify_store(d):
    errors, warnings = [], []
    if not os.path.isdir(d):
        return ["store does not exist: %s" % pretty(d)], warnings, 0, 0
    path = log_path(d)
    if os.path.islink(path):
        return ["LOG.txt is a symbolic link"], warnings, 0, 0
    if not os.path.isfile(path):
        return ["LOG.txt is missing"], warnings, 0, 0
    raw_size = os.path.getsize(path)
    if raw_size % LOG_REC:
        errors.append("LOG.txt has %d trailing byte(s)"
                      % (raw_size % LOG_REC))
    total = raw_size // LOG_REC
    previous_date = None
    with open(path, "rb") as source:
        for expected in range(total):
            raw = source.read(LOG_REC)
            if len(raw) != LOG_REC:
                errors.append("LOG.txt record #%d is truncated" % expected)
                break
            if not raw.endswith(b"\n"):
                errors.append("LOG.txt record #%d has no terminal newline"
                              % expected)
            try:
                line = raw.decode("utf-8").rstrip()
            except UnicodeDecodeError:
                errors.append("LOG.txt record #%d is not UTF-8" % expected)
                continue
            if not line.startswith("#%d " % expected):
                errors.append("LOG.txt record #%d has an invalid ID prefix"
                              % expected)
            try:
                ident, date, text = parse(line)
            except (ValueError, IndexError):
                errors.append("LOG.txt record #%d does not parse" % expected)
                continue
            if ident != expected:
                errors.append("LOG.txt position #%d identifies itself as #%d"
                              % (expected, ident))
            try:
                datetime.date.fromisoformat(date)
            except ValueError:
                errors.append("memory #%d has invalid date %s"
                              % (expected, date))
            if previous_date is not None and date < previous_date:
                errors.append("memory #%d date %s precedes %s"
                              % (expected, date, previous_date))
            previous_date = date
            if not text:
                errors.append("memory #%d has an empty payload" % expected)
            lifecycle = _LIFECYCLE_REF.match(text)
            if lifecycle and int(lifecycle.group(2)) >= expected:
                errors.append("%s #%d points forward or to itself"
                              % (lifecycle.group(1), expected))

    tree = os.path.join(d, "TREE")
    summaries = 0
    if os.path.islink(tree):
        errors.append("TREE directory is a symbolic link")
    elif not os.path.isdir(tree):
        errors.append("TREE directory is missing")
    else:
        for name in os.listdir(tree):
            node = os.path.join(tree, name)
            if not os.path.isfile(node) or os.path.islink(node):
                errors.append("unexpected TREE entry: %s" % name)
                continue
            if not name.isdigit():
                errors.append("unexpected TREE file: %s" % name)
                continue
            width = int(name)
            if width < 2 or width & (width - 1):
                errors.append("TREE/%s is not a power-of-two level" % name)
                continue
            length = os.path.getsize(node)
            if length % TREE_REC:
                errors.append("TREE/%s has %d trailing byte(s)"
                              % (name, length % TREE_REC))
            count_ = length // TREE_REC
            summaries += count_
            if count_ > total // width:
                errors.append("TREE/%s contains %d impossible trailing node(s)"
                              % (name, count_ - total // width))
            with open(node, "rb") as source:
                for index in range(count_):
                    record = source.read(TREE_REC)
                    try:
                        summary = record.decode("utf-8").rstrip()
                    except UnicodeDecodeError:
                        errors.append("TREE/%s node %d is not UTF-8"
                                      % (name, index))
                        continue
                    if not record.endswith(b"\n"):
                        errors.append("TREE/%s node %d has no terminal newline"
                                      % (name, index))
                    if not summary:
                        errors.append("TREE/%s has a blank node inside its "
                                      "dense prefix at index %d" % (name, index))
            if width > 2 and count_:
                child = tree_path(d, width // 2)
                child_count = count(child, TREE_REC)
                needed = count_ * 2
                if child_count < needed:
                    errors.append("TREE/%s has nodes without both TREE/%d "
                                  "children (%d needed, %d present)"
                                  % (name, width // 2, needed, child_count))

    if qmd_enabled(d):
        try:
            state = _qmd_state(d)
            expected_segments = ((total + QMD_SEGMENT_SIZE - 1) //
                                 QMD_SEGMENT_SIZE)
            actual_segments = len(_qmd_projection_files(d))
            if state is None:
                warnings.append("QMD projection state is missing or invalid; "
                                "run: %s qmd sync" % ME)
            elif state["logRecords"] != total:
                warnings.append("QMD projection is stale (%d log records, %d "
                                "projected); run: %s qmd sync"
                                % (total, state["logRecords"], ME))
            elif actual_segments != expected_segments:
                warnings.append("QMD projection has %d segment(s), expected "
                                "%d; run: %s qmd sync"
                                % (actual_segments, expected_segments, ME))
        except QmdError as e:
            errors.append("QMD projection is unsafe: %s" % e)
    return errors, warnings, total, summaries


def cmd_doctor(d, args):
    """Explain what this invocation will use without creating or changing it."""
    deep = args == ["--deep"]
    if args and not deep:
        die("usage: %s doctor [--deep]" % ME)
    project_info = project_scope()
    project = project_info["store"]
    global_ = os.path.expanduser(GLOBAL)
    override = os.environ.get("MEMORY_DIR")
    if override:
        scope = "MEMORY_DIR override"
    elif SCOPE_GLOBAL:
        scope = "global"
    else:
        scope = "project"

    try:
        import fff
        fff_status = "available%s" % (
            " (%s)" % fff.__version__ if getattr(fff, "__version__", None) else "")
    except Exception:
        if sys.version_info < (3, 10):
            fff_status = "unavailable (optional; requires Python 3.10+)"
        else:
            fff_status = "not installed (optional: python -m pip install fff-search)"

    remote = (
        "%s = %s" % (project_info["remote_name"],
                     safe_origin_alias(project_info["remote_url"]))
        if project_info["remote_name"] else "none")
    on_path = bool(shutil.which("memo") or shutil.which("memo.cmd"))
    print("OptMem doctor")
    print("  Version:       %s" % VERSION)
    print("  Tool:          %s" % pretty(__file__))
    print("  Python:        %s" % sys.version.split()[0])
    print("  On PATH:       %s (optional)" % ("yes" if on_path else "no"))
    print("  Git remote:    %s" % remote)
    print("  Scope source:  %s" % project_info["source"])
    print("  Scope layout:  %s" % project_info["layout"])
    print("  Active scope:  %s" % scope)
    print("  Active store:  %s [%s]" % (pretty(d), memory_status(d)))
    print("  Project store: %s [%s]" % (pretty(project), memory_status(project)))
    print("  Global store:  %s [%s]" % (pretty(global_), memory_status(global_)))
    print("  FFF recall:    %s" % fff_status)
    qmd = _qmd_status(d)
    print("  QMD executable:   %s" % qmd["executable"])
    print("  QMD integration: %s" %
          ("enabled" if qmd["enabled"] else "disabled"))
    print("  QMD fallback:    %s" % (
        "on" if qmd["fallback"] and qmd["enabled"] else
        "on (inactive)" if qmd["fallback"] else "off"))
    print("  QMD projection:  %s" % qmd["projection"])
    print("  QMD collection:  %s" % qmd["collection"])
    print("  QMD embeddings:  %s" % qmd["embeddings"])
    identity, collision = _scope_identity_status(d)
    print("  Scope identity: %s" % identity)
    if collision:
        print("  WARNING:        %s" % collision)
    if project_info["warning"]:
        print("  WARNING:        %s" % project_info["warning"])
    if deep:
        errors, warnings, records_, summaries = _verify_store(d)
        print()
        print("Deep verification")
        print("  Raw records:    %d" % records_)
        print("  Tree summaries: %d" % summaries)
        for warning in warnings:
            print("  Warning:        %s" % warning)
        if errors:
            print("  Result:         FAILED (%s)"
                  % plural(len(errors), "problem"))
            for problem in errors:
                print("    - %s" % problem)
            sys.exit(1)
        print("  Result:         OK%s"
              % (" with %s" % plural(len(warnings), "warning")
                 if warnings else ""))
    if memory_status(global_) == "not created":
        print()
        print("Next: create global memory with: %s init" % TOOL)
    elif not on_path:
        print()
        print("Ready. PATH is not active in this shell; open a new shell or")
        print("use the full path shown above. Generated instructions already do.")


COMMANDS = {"version": cmd_version, "init": cmd_init, "setup": cmd_setup,
            "completion": cmd_completion, "upgrade": cmd_upgrade,
            "uninstall": cmd_uninstall, "scope": cmd_scope,
            "qmd": cmd_qmd, "wake": cmd_wake,
            "note": cmd_note, "show": cmd_show, "amend": cmd_amend,
            "retract": cmd_retract, "redact": cmd_redact,
            "nap": cmd_nap, "recall": cmd_recall, "zoom": cmd_zoom,
            "resummarize": cmd_resummarize, "forget": cmd_forget,
            "config": cmd_config, "export": cmd_export, "import": cmd_import,
            "doctor": cmd_doctor}


def main():
    global SCOPE_GLOBAL, ME
    argv = list(sys.argv[1:])
    then_project = False
    while argv and argv[0] in ("--global", "--then-project"):
        flag = argv.pop(0)
        if flag == "--global":
            SCOPE_GLOBAL = True
        else:
            then_project = True
    if SCOPE_GLOBAL:
        # Every command printed by this scope must return to the same scope.
        ME = TOOL + " --global"
    usage = __doc__.strip().format(memo=TOOL)
    if argv == ["--version"]:
        cmd_version(None, [])
        return
    if not argv or argv[0] in ("help", "--help", "-h"):
        print(usage)
        sys.exit(0)
    cmd = argv[0]
    if cmd not in COMMANDS:
        print("No such command: %s\n" % cmd, file=sys.stderr)
        print(usage, file=sys.stderr)
        print("\nRun: %s --help" % TOOL, file=sys.stderr)
        sys.exit(1)
    if then_project and (not SCOPE_GLOBAL or cmd != "wake"):
        die("Invalid wake continuation. Run: %s wake" % TOOL)
    try:
        # `init` is the only command that may run without an existing memory:
        # it is the one that creates it. Every other command refuses, so a
        # typo in MEMORY_DIR is an error instead of a second, empty identity.
        if cmd == "version":
            cmd_version(None, argv[1:])
            return
        if cmd == "init":
            # A bare init creates the one global identity. Project stores need
            # no ceremony and appear on first use.
            SCOPE_GLOBAL = not os.environ.get("MEMORY_DIR")
            cmd_init(memory_dir(), argv[1:])
            return
        if cmd == "setup":
            cmd_setup(instruction_dir(), argv[1:])
            return
        if cmd == "completion":
            cmd_completion(None, argv[1:])
            return
        if cmd == "upgrade":
            cmd_upgrade(None, argv[1:])
            return
        if cmd == "uninstall":
            cmd_uninstall(None, argv[1:])
            return
        if cmd == "scope":
            cmd_scope(memory_dir(), argv[1:])
            return
        if cmd == "qmd":
            qmd_args = argv[1:]
            read_only = (not qmd_args or qmd_args[0] in
                         ("help", "--help", "-h", "status", "sync",
                          "rebuild", "config", "disable"))
            invalid = bool(qmd_args and qmd_args[0] not in
                           ("enable", "status", "sync", "rebuild", "config",
                            "disable", "help", "--help", "-h"))
            if read_only or invalid:
                cmd_qmd(memory_dir(), qmd_args)
                return
        if cmd == "recall" and "--semantic" in argv[1:]:
            _, semantic, fast, _, _, query = _recall_args(argv[1:])
            if semantic and not qmd_enabled(memory_dir()):
                _print_semantic(memory_dir(), query, fast=fast)
                return
        if (cmd == "wake" and not argv[1:] and not SCOPE_GLOBAL and
                not os.environ.get("MEMORY_DIR")):
            wake_both()
            return
        if cmd == "doctor":
            cmd_doctor(memory_dir(), argv[1:])
            return
        if cmd == "import" and "--dry-run" in argv[1:]:
            d = memory_dir()
            if os.path.isdir(d):
                config(d)
            else:
                for key, (default, _) in KNOBS.items():
                    globals()[key] = default
            cmd_import(d, argv[1:])
            return
        d = store()
        config(d)
        if cmd == "wake" and SCOPE_GLOBAL and then_project:
            done = cmd_wake(d, argv[1:], tail=False,
                            continuation=TOOL + " --global --then-project")
            if done:
                print()
                # Return to the ordinary project path so symlink checks,
                # identity recording, configuration, and future hardening all
                # remain centralized in store().
                SCOPE_GLOBAL = False
                ME = TOOL
                wake_project([])
            return
        COMMANDS[cmd](d, argv[1:])
    except OSError as e:
        # The filesystem is the one thing the tool does not control. Report it
        # the way every other failure is reported: a Python traceback tells an
        # agent nothing it can act on.
        die("%s: %s." % (pretty(e.filename or memory_dir()), e.strerror or e))


if __name__ == "__main__":
    main()
