def wake_both():
    """Read the global memory first, then the project memory.

    Only a bare `wake` enters here. A `wake` with paging arguments is already
    a project continuation and must not restart the global document.
    """
    global ME
    g = os.path.expanduser(GLOBAL)
    if os.path.isdir(g):
        previous, ME = ME, TOOL + " --global"
        config(g)
        print("== Global memory: what is true in every project ==")
        done = cmd_wake(g, [], tail=False,
                        continuation=TOOL + " --global --then-project")
        ME = previous
        if not done:
            return
        print()
    else:
        print("No global memory yet; only this project will be remembered.\n"
              "To create one, run: %s init\n" % TOOL)
    wake_project([])


