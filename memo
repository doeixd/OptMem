AGENT_START = "<!-- OPTMEM:START -->"
AGENT_END = "<!-- OPTMEM:END -->"


def instruction_dir():
    """The global identity named in persistent agent instructions.

    Setup does not open or create a memory store, so it deliberately ignores
    the current project scope. MEMORY_DIR remains useful for custom installs.
    """
    return os.path.expanduser(os.environ.get("MEMORY_DIR") or GLOBAL)


def agent_block(d, newline="\n"):
    """The replaceable block written into an agent instruction file."""
    body = TEMPLATE.format(memo=TOOL, data=pretty(d),
                           chars=ENTRY_CHARS).rstrip()
    return newline.join((AGENT_START, body.replace("\n", newline), AGENT_END))


def _setup_plan(path, block_for, create):
    """Preflight one instruction file without changing it."""
    path = os.path.abspath(os.path.expanduser(path))
    if os.path.islink(path):
        die("Refusing to replace symlink %s." % pretty(path))
    exists = os.path.exists(path)
    if not exists and not create:
        return path, b"", b"", "skipped", False
    parent = os.path.dirname(path)
    if not os.path.isdir(parent):
        die("Parent directory does not exist: %s." % pretty(parent))
    if os.path.isdir(path):
        die("Instruction target is a directory: %s." % pretty(path))

    raw = open(path, "rb").read() if exists else b""
    bom = b"\xef\xbb\xbf" if raw.startswith(b"\xef\xbb\xbf") else b""
    try:
        text = raw[len(bom):].decode("utf-8")
    except UnicodeDecodeError:
        die("Instruction file is not UTF-8: %s." % pretty(path))

    starts, ends = text.count(AGENT_START), text.count(AGENT_END)
    if starts != ends or starts > 1:
        die("Malformed OptMem markers in %s; expected one START/END pair."
            % pretty(path))
    if starts and text.index(AGENT_END) < text.index(AGENT_START):
        die("Malformed OptMem markers in %s; END appears before START."
            % pretty(path))
    newline = "\r\n" if "\r\n" in text else "\n"
    block = block_for(newline)
    if starts:
        lo = text.index(AGENT_START)
        hi = text.index(AGENT_END, lo) + len(AGENT_END)
        updated = text[:lo] + block + text[hi:]
        action = "current" if updated == text else "updated"
    elif "Your memory is OptMem:" in text:
        # Older hand-copied instructions have no managed markers. Their
        # presence still satisfies "if not already present"; never duplicate.
        updated, action = text, "legacy"
    else:
        updated = block + (newline * 2 + text if text else newline)
        action = "added"
    return path, raw, bom + updated.encode("utf-8"), action, exists


def _atomic_replace(path, data, existing):
    """Replace one preflighted file in its directory, preserving its mode."""
    parent = os.path.dirname(path)
    mode = os.stat(path).st_mode if existing else None
    fd, temporary = tempfile.mkstemp(prefix=".optmem-", suffix=".tmp",
                                     dir=parent)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        if mode is not None:
            os.chmod(temporary, mode)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def cmd_setup(d, args):
    """Install the managed instructions into one or more agent files."""
    create, explicit_no_create, targets = False, False, []
    for arg in args:
        if arg == "--create":
            create = True
        elif arg == "--no-create":
            explicit_no_create = True
        elif arg.startswith("--"):
            die("Unknown setup option: %s.\nUsage: %s setup "
                "[--create|--no-create] [FILE ...]" % (arg, TOOL))
        else:
            targets.append(arg)
    if create and explicit_no_create:
        die("Use either --create or --no-create, not both.")
    targets = targets or ["AGENTS.md", "CLAUDE.md"]
    unique, seen = [], set()
    for target in targets:
        key = os.path.normcase(os.path.realpath(os.path.abspath(
            os.path.expanduser(target))))
        if key not in seen:
            seen.add(key)
            unique.append(target)

    block_for = lambda newline: agent_block(d, newline)
    plans = [_setup_plan(target, block_for, create) for target in unique]
    # Preflight every target before the first write. A malformed second file
    # must not leave the first file half-configured.
    for path, before, after, action, existing in plans:
        if action not in ("current", "legacy", "skipped"):
            current_exists = os.path.exists(path)
            current = open(path, "rb").read() if current_exists else b""
            if current_exists != existing or current != before:
                die("Instruction file changed during setup: %s." % pretty(path))
            _atomic_replace(path, after, existing)
        if action == "added":
            print("Added OptMem instructions to %s." % pretty(path))
        elif action == "updated":
            print("Updated OptMem instructions in %s." % pretty(path))
        elif action == "legacy":
            print("Already configured: %s (unmanaged legacy block)."
                  % pretty(path))
        elif action == "skipped":
            print("Skipped missing: %s (use --create to create it)."
                  % pretty(path))
        else:
            print("Already configured: %s." % pretty(path))


def cmd_completion(d, args):
    """Print a completion script without opening or creating memory."""
    if len(args) != 1 or args[0].lower() not in COMPLETIONS:
        die("Usage: %s completion <bash|zsh|fish|powershell>" % TOOL)
    print(COMPLETIONS[args[0].lower()].rstrip())


def cmd_version(d, args):
    if args:
        die("Usage: %s version" % TOOL)
    print("OptMem %s" % VERSION)


def _install_dir():
    return os.path.abspath(os.path.expanduser("~/.optmem"))


def _require_installed(command):
    """Never let maintenance commands overwrite or delete a source checkout."""
    expected = os.path.join(_install_dir(), "memo")
    actual = os.path.abspath(__file__)
    same = (os.path.normcase(os.path.realpath(actual)) ==
            os.path.normcase(os.path.realpath(expected)))
    if not same:
        die("%s only operates on the installed copy at %s, not this source "
            "checkout.\nRun the installed `memo %s` command instead."
            % (command.capitalize(), pretty(expected), command))
    return _install_dir()


def cmd_upgrade(d, args):
    """Run the authoritative installer, which validates before replacement."""
    if args:
        die("Usage: %s upgrade" % TOOL)
    _require_installed("upgrade")
    import urllib.request
    windows = os.name == "nt"
    name = "install.ps1" if windows else "install.sh"
    url = INSTALL_BASE + "/" + name
    try:
        with urllib.request.urlopen(url, timeout=30) as response:
            script = response.read(500001)
    except Exception as e:
        die("Could not download %s: %s." % (url, e))
    if len(script) > 500000 or b"OptMem installer" not in script:
        die("Refusing unexpected installer content from %s." % url)

    fd, path = tempfile.mkstemp(prefix="optmem-upgrade-",
                                suffix=(".ps1" if windows else ".sh"))
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(script)
            f.flush()
            os.fsync(f.fileno())
        if windows:
            shell = shutil.which("powershell") or shutil.which("pwsh")
            if not shell:
                die("Upgrade needs PowerShell, but neither powershell nor "
                    "pwsh is available.")
            command = [shell, "-NoProfile", "-ExecutionPolicy", "Bypass",
                       "-File", path]
        else:
            command = ["sh", path]
        result = subprocess.run(command)
        if result.returncode:
            die("Upgrade installer exited with status %d." % result.returncode)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


def _remove_managed_pair(path, marker, line):
    """Remove only a marker/line pair OptMem owns; preserve all other bytes."""
    if not os.path.isfile(path):
        return False
    path = os.path.realpath(path)
    raw = open(path, "rb").read()
    if raw.startswith(b"\xef\xbb\xbf"):
        bom, encoding, body = b"\xef\xbb\xbf", "utf-8", raw[3:]
    elif raw.startswith(b"\xff\xfe"):
        bom, encoding, body = b"\xff\xfe", "utf-16-le", raw[2:]
    elif raw.startswith(b"\xfe\xff"):
        bom, encoding, body = b"\xfe\xff", "utf-16-be", raw[2:]
    else:
        bom, body = b"", raw
        try:
            body.decode("utf-8")
            encoding = "utf-8"
        except UnicodeDecodeError:
            # A byte-for-byte fallback for legacy ANSI profiles. The managed
            # lines are ASCII, so latin-1 finds them without corrupting any
            # other byte when the file is encoded again.
            encoding = "latin-1"
    text = body.decode(encoding)
    updated = text
    for newline in ("\r\n", "\n"):
        pair = marker + newline + line
        updated = updated.replace(pair + newline, "")
        updated = updated.replace(pair, "")
    if updated == text:
        return False
    _atomic_replace(path, bom + updated.encode(encoding), True)
    return True


def _windows_profile_paths():
    """All common all-hosts PowerShell profiles, including redirected ones."""
    home = os.path.expanduser("~")
    paths = [
        os.path.join(home, "Documents", "WindowsPowerShell", "profile.ps1"),
        os.path.join(home, "Documents", "PowerShell", "profile.ps1"),
    ]
    for shell_name in ("powershell", "pwsh"):
        shell = shutil.which(shell_name)
        if not shell:
            continue
        result = subprocess.run(
            [shell, "-NoProfile", "-Command",
             "[Console]::Out.Write($PROFILE.CurrentUserAllHosts)"],
            capture_output=True, text=True)
        if result.returncode == 0 and result.stdout.strip():
            paths.append(result.stdout.strip())
    out, seen = [], set()
    for path in paths:
        key = os.path.normcase(os.path.abspath(path))
        if key not in seen:
            seen.add(key)
            out.append(path)
    return out


def _remove_windows_user_path(install):
    """Remove exactly the installed directory from the persistent user PATH."""
    import winreg
    try:
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, "Environment", 0,
                             winreg.KEY_QUERY_VALUE | winreg.KEY_SET_VALUE)
    except OSError:
        return False
    try:
        try:
            value, kind = winreg.QueryValueEx(key, "Path")
        except OSError:
            return False
        target = os.path.normcase(os.path.normpath(install))
        parts, changed = [], False
        for part in value.split(";"):
            expanded = os.path.expandvars(part.strip().strip('"'))
            if expanded and os.path.normcase(os.path.normpath(expanded)) == target:
                changed = True
            elif part:
                parts.append(part)
        if changed:
            winreg.SetValueEx(key, "Path", 0, kind, ";".join(parts))
            try:
                import ctypes
                send = ctypes.windll.user32.SendMessageTimeoutW
                send.argtypes = [
                    ctypes.c_void_p, ctypes.c_uint, ctypes.c_void_p,
                    ctypes.c_wchar_p, ctypes.c_uint, ctypes.c_uint,
                    ctypes.POINTER(ctypes.c_size_t)]
                result = ctypes.c_size_t()
                send(ctypes.c_void_p(0xffff), 0x001a, None, "Environment",
                     0x0002, 5000, ctypes.byref(result))
            except Exception:
                pass  # The registry is authoritative; broadcast is best effort.
        return changed
    finally:
        winreg.CloseKey(key)


def _schedule_windows_removal(paths):
    """Delete files locked by the parent memo.cmd after this process exits."""
    fd, helper = tempfile.mkstemp(prefix="optmem-uninstall-", suffix=".cmd")
    lines = ["@echo off", "for /l %%N in (1,1,15) do ("]
    for path in paths:
        lines.append('  del /f /q "%s" >nul 2>&1' % path.replace("%", "%%"))
    lines.extend(["  timeout /t 1 /nobreak >nul", ")",
                  'del /f /q "%~f0" >nul 2>&1'])
    with os.fdopen(fd, "w", newline="\r\n") as f:
        f.write("\n".join(lines) + "\n")
    flags = 0x08000000 | 0x00000008  # CREATE_NO_WINDOW | DETACHED_PROCESS
    subprocess.Popen(["cmd.exe", "/d", "/c", helper],
                     creationflags=flags, close_fds=True)


def cmd_uninstall(d, args):
    """Remove program integrations and executables, never memory data."""
    if args:
        die("Usage: %s uninstall" % TOOL)
    install = _require_installed("uninstall")
    home = os.path.expanduser("~")

    if os.name == "nt":
        completion = os.path.join(install, "memo-completion.ps1")
        source = ". '%s'" % completion.replace("'", "''")
        for profile in _windows_profile_paths():
            _remove_managed_pair(profile, "# OptMem completion", source)
        _remove_windows_user_path(install)
        completion_files = [completion]
    else:
        export = 'export PATH="$HOME/.optmem:$PATH"'
        fish_path = 'fish_add_path -g "$HOME/.optmem"'
        for profile in (os.path.join(home, ".bashrc"),
                        os.path.join(home, ".zshrc"),
                        os.path.join(home, ".profile")):
            _remove_managed_pair(profile, "# OptMem command", export)
        _remove_managed_pair(
            os.path.join(home, ".config", "fish", "config.fish"),
            "# OptMem command", fish_path)
        _remove_managed_pair(
            os.path.join(home, ".zshrc"), "# OptMem completion",
            'fpath=("$HOME/.zfunc" $fpath); autoload -Uz compinit && compinit')
        completion_files = [
            os.path.join(os.environ.get("XDG_DATA_HOME") or
                         os.path.join(home, ".local", "share"),
                         "bash-completion", "completions", "memo"),
            os.path.join(home, ".zfunc", "_memo"),
            os.path.join(os.environ.get("XDG_CONFIG_HOME") or
                         os.path.join(home, ".config"),
                         "fish", "completions", "memo.fish"),
        ]

    files = completion_files + [
        os.path.join(install, "memo.cmd"),
        os.path.join(install, "memo"),
    ]
    pending = []
    for path in files:
        if not os.path.lexists(path):
            continue
        try:
            os.unlink(path)
        except PermissionError:
            pending.append(path)
    if pending:
        if os.name == "nt":
            _schedule_windows_removal(pending)
            print("Locked launcher files will be removed after this command exits.")
        else:
            die("Could not remove: %s." % ", ".join(map(pretty, pending)))

    project_root = os.path.join(
        os.environ.get("XDG_DATA_HOME") or
        os.path.join(home, ".local", "share"), "optmem")
    print("Uninstalled the memo command and shell completion.")
    print("Preserved global memory: %s" %
          pretty(os.path.join(install, "memory")))
    print("Preserved project memories: %s" % pretty(project_root))
    print("Agent instruction blocks were not removed. If retiring OptMem,")
    print("remove its OPTMEM:START/END block from connected instruction files.")
    print("QMD projections and external collections were not removed.")
    print("Open a new shell to finish removing memo from the current PATH.")


