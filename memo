def _nap_apply(d, path):
    if os.path.getsize(path) > MAX_NAP_APPLY_BYTES:
        die("%s is too large for a nap batch (limit %d bytes)."
            % (pretty(path), MAX_NAP_APPLY_BYTES))
    try:
        source = open(path, encoding="utf-8").read().splitlines()
    except UnicodeDecodeError:
        die("%s is not UTF-8 text." % pretty(path))
    rows = []
    for number, line in enumerate(source, 1):
        if not line.strip():
            continue
        block, tab, summary = line.partition("\t")
        if not tab:
            die("line %d: expected <range><TAB><one-line summary>." % number)
        lo, hi = block_id(block.strip())
        rows.append((lo, hi, check(summary)))
        if len(rows) > MAX_NAP_BATCH:
            die("A nap batch holds at most %d summaries." % MAX_NAP_BATCH)
    if not rows:
        die("%s has no summaries." % pretty(path))
    T = log_len(d)
    expected = batch_pending(d, T, len(rows))
    actual = [(lo, hi) for lo, hi, _ in rows]
    if actual != expected:
        wanted = ", ".join("%d-%d" % (lo, hi - 1)
                           for lo, hi in expected) or "none"
        die("Batch is stale or out of order. Expected: %s. Run: %s nap "
            "--batch %d" % (wanted, ME, len(rows)))
    if not tree_put_batch(d, rows):
        die("The compression queue changed while applying the batch. Run: "
            "%s nap --batch %d" % (ME, len(rows)))
    print("Saved %s." % plural(len(rows), "summary"))
    left = pending_count(d, T)
    if left:
        print("%s %s. Run: %s nap --batch %d"
              % (plural(left, "compression"),
                 "remains" if left == 1 else "remain", ME, len(rows)))
    else:
        print("Nothing left to compress.")


def cmd_nap(d, args):
    T, said = log_len(d), False
    if args and args[0] == "--batch":
        if (len(args) != 2 or not args[1].isdigit() or
                not 1 <= int(args[1]) <= MAX_NAP_BATCH):
            die("usage: %s nap --batch <1-%d>" % (ME, MAX_NAP_BATCH))
        jobs, prompt = fitted_batch_prompt(d, T, int(args[1]))
        if not jobs:
            if pending_count(d, T):
                die("The current PART_CHARS/PART_LINES budget cannot fit one "
                    "batch job. Run: %s nap" % ME)
            print("Nothing left to compress.")
            return
        print(prompt)
        return
    if args and args[0] == "--apply":
        if len(args) != 2:
            die("usage: %s nap --apply <UTF-8 file>" % ME)
        _nap_apply(d, args[1])
        return
    if args:
        said = True
        if len(args) != 2:
            die("usage: %s nap <lo>-<hi> \"<one line>\"" % ME)
        lo, hi = block_id(args[0])
        todo = pending(d, T, limit=1)
        if not todo:
            print("Nothing left to compress.")
            return
        if (lo, hi) != todo[0]:
            if tree_get(d, lo, hi) is not None:
                print("%d-%d is already settled." % (lo, hi - 1))
            else:
                die("Wrong block: %s. Blocks are built in order; the next is "
                    "%d-%d. Run: %s nap"
                    % (args[0], todo[0][0], todo[0][1] - 1, ME))
        elif not tree_put(d, lo, hi, check(args[1])):
            print("%d-%d was settled or forgotten meanwhile." % (lo, hi - 1))
        else:
            print("%d-%d saved." % (lo, hi - 1))
    nap = next_nap(d, T)
    if not nap:
        print("Nothing left to compress.")
        return
    print(("\n" if said else "") + nap)


def cmd_config(d, args):
