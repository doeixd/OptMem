# Records are FIXED WIDTH, so a memory or a block is found by seeking to its
# offset -- no scanning, no index file to keep in sync. Position IS identity:
# memory i lives at i*LOG_REC of LOG.txt, and block [k*s,(k+1)*s) lives at
# k*TREE_REC of TREE/<s>. Padding costs ~2x on disk and buys O(1) everywhere.
LOG_REC = 320
TREE_REC = 288


# ---------------------------------------------------------------- blocks

# A BLOCK is an aligned power-of-two range of memories, [lo,hi), compressed
# into one line. Blocks form a binary merge tree over LOG.txt: block [lo,hi)
# is the compression of [lo,mid) and [mid,hi).

def _cover(T, alpha):
    """Tile [0,T) with aligned power-of-two blocks; keep a block whole iff its
    size is at most `alpha` times its age. Bigger alpha = coarser = fewer
    lines."""
    root = 1
    while root < T:
        root *= 2
    out, stack = [], [(0, root)]
    while stack:
        lo, hi = stack.pop()
        if lo >= T:
            continue
        size = hi - lo
        if size > 1 and (hi > T or size > alpha * (T - lo)):
            mid = (lo + hi) // 2
            stack.append((mid, hi))
            stack.append((lo, mid))
        else:
            out.append((lo, hi))
    out.sort()
    return out


def cover(T, budget):
    """The blocks `memo wake` prints: at most `budget` of them, finest near T.

    Detail decays with age, so recent memories stay verbatim and ancient ones
    collapse. If everything fits, nothing is compressed at all."""
    if T <= 0:
        return []
    if T <= budget:
        return [(i, i + 1) for i in range(T)]
    lo, hi = 0.0, 1.0
    for _ in range(60):
        mid = (lo + hi) / 2
        if len(_cover(T, mid)) > budget:
            lo = mid
        else:
            hi = mid
    out = _cover(T, hi)
    # Block sizes jump in powers of two, so alpha alone can undershoot the
    # budget. Spend what is left on the present, where detail is worth most.
    while len(out) < budget:
        i = max((i for i, b in enumerate(out) if b[1] - b[0] > 1), default=None)
        if i is None:
            break
        lo_, hi_ = out[i]
        mid = (lo_ + hi_) // 2
        out[i:i + 1] = [(lo_, mid), (mid, hi_)]
    return out


# ---------------------------------------------------------------- store

def git(*args):
    """What a git command printed, or "" if it failed or git is not here."""
    try:
        r = subprocess.run(("git",) + args, capture_output=True, text=True)
    except OSError:
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def canonical_origin(url):
    """A full host/namespace/repository identity, independent of transport."""
    value = url.strip()
    if not value:
        return ""
    host, path = "", ""
    if "://" in value:
        parsed = urllib.parse.urlsplit(value)
        host = (parsed.hostname or "").lower()
        try:
            port = parsed.port
        except ValueError:
            return ""
        defaults = {"http": 80, "https": 443, "ssh": 22}
        if port and port != defaults.get(parsed.scheme.lower()):
            host += ":%d" % port
        path = parsed.path
    else:
        match = re.match(r"^(?:[^@/\\:]+@)?([^/\\:]+):(.+)$", value)
        if match and not re.match(r"^[A-Za-z]:[\\/]", value):
            host, path = match.group(1).lower(), match.group(2)
    if not host:
        return ""
    parts = [part for part in re.split(r"[/\\]+", path.strip("/\\"))
             if part]
    if parts:
        parts[-1] = re.sub(r"\.git/*$", "", parts[-1])
    if not parts:
        return ""
    return host + "/" + "/".join(parts)


def safe_origin_alias(url):
    """Origin spelling without URL credentials, suitable for scope.json."""
    value = url.strip()
    if "://" in value:
        parsed = urllib.parse.urlsplit(value)
        host = parsed.hostname or ""
        try:
            port = parsed.port
        except ValueError:
            return canonical_origin(value)
        netloc = host + (":%d" % port if port else "")
        return urllib.parse.urlunsplit(
            (parsed.scheme, netloc, parsed.path, "", ""))
    match = re.match(r"^([^@/\\:]+)@([^/\\:]+):(.+)$", value)
    if match and match.group(1).lower() not in ("git", "ssh"):
        return "%s:%s" % (match.group(2), match.group(3))
    return value


def _scope_identity_path(d):
    return os.path.join(d, "scope.json")


def _read_scope_identity(d):
    path = _scope_identity_path(d)
    if not os.path.isfile(path) or os.path.islink(path):
        return None
    try:
        with open(path, encoding="utf-8") as f:
            value = json.load(f)
    except (OSError, ValueError):
        return None
    if (not isinstance(value, dict) or value.get("version") != 1 or
            not isinstance(value.get("canonical"), str) or
            not isinstance(value.get("aliases"), list) or
            not all(isinstance(item, str) for item in value["aliases"])):
        return None
    return value


def _scope_root():
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(data, "optmem")


def _scope_key(identity):
    return hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24]


def _scope_label(value):
    """A short readable path component; the hash supplies actual identity."""
    label = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip(" .-_")
    if not label:
        label = "project"
    if label.upper() in {
            "CON", "PRN", "AUX", "NUL",
            "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8",
            "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7",
            "LPT8", "LPT9"}:
        label = "_" + label
    return label[:48]


def _legacy_remote_dir(root, url, canonical):
    safe = canonical or safe_origin_alias(url)
    parts = re.split(r"[:/]", re.sub(r"\.git/*$", "", safe).rstrip("/"))
    return os.path.join(root, "repo", *parts[-2:])


def _legacy_path_dir(root, project):
    drive, tail = os.path.splitdrive(os.path.abspath(project))
    parts = [part for part in re.split(r"[\\/]+", tail) if part]
    if drive:
        parts.insert(0, drive.rstrip(":"))
    return os.path.join(root, "path", *parts)


def _stored_identity_matches(stored, identity):
    """Match current identities and safely upgrade old truncated identities."""
    if stored is None:
        return False
    if stored["canonical"] == identity:
        return True
    return any(canonical_origin(alias) == identity for alias in stored["aliases"])


def _scope_map_path():
    return os.path.join(_scope_root(), "scope-map.json")


def _read_scope_map():
    path = _scope_map_path()
    if not os.path.isfile(path) or os.path.islink(path):
        return {}
    try:
        with open(path, encoding="utf-8") as source:
            value = json.load(source)
    except (OSError, ValueError):
        return {}
    if not isinstance(value, dict):
        return {}
    links = value.get("links")
    if value.get("version") != 1 or not isinstance(links, dict):
        return {}
    return {key: target for key, target in links.items()
            if isinstance(key, str) and isinstance(target, str)}


def _linked_scope_dir(identity):
    """Resolve a central path-scope link without permitting path traversal."""
    relative = _read_scope_map().get(identity)
    if not relative or os.path.isabs(relative):
        return ""
    root = os.path.abspath(_scope_root())
    target = os.path.abspath(os.path.join(root, relative))
    try:
        inside = (os.path.commonpath((root, target)) == root and
                  os.path.commonpath((os.path.realpath(root),
                                      os.path.realpath(target))) ==
                  os.path.realpath(root))
    except ValueError:
        inside = False
    return target if (inside and not os.path.islink(target)
                      and os.path.isdir(target)) else ""


def _remote_selection():
    """Select a usable Git remote without guessing among ambiguous choices."""
    explicit = os.environ.get("OPTMEM_REMOTE")
    if explicit:
        names = [name for name in git("remote").splitlines() if name]
        if explicit not in names:
            die("OPTMEM_REMOTE names '%s', but this checkout has: %s."
                % (explicit, ", ".join(names) if names else "no remotes"))
        url = git("remote", "get-url", explicit)
        canonical = canonical_origin(url)
        if not canonical:
            die("Git remote '%s' has no usable hosted repository URL: %s."
                % (explicit, safe_origin_alias(url)))
        return explicit, url, canonical, "OPTMEM_REMOTE"

    origin_url = git("remote", "get-url", "origin")
    origin_canonical = canonical_origin(origin_url)
    if origin_canonical:
        return ("origin", origin_url, origin_canonical,
                "Git remote 'origin'")

    names = [name for name in git("remote").splitlines() if name]
    usable = {}
    for name in names:
        if name == "origin":
            continue
        url = git("remote", "get-url", name)
        canonical = canonical_origin(url)
        if canonical:
            usable[name] = (url, canonical)

    upstream = git("rev-parse", "--abbrev-ref", "--symbolic-full-name",
                   "@{upstream}")
    tracked = [name for name in usable if upstream.startswith(name + "/")]
    if tracked:
        name = max(tracked, key=len)
        url, canonical = usable[name]
        return name, url, canonical, "tracked Git remote '%s'" % name
    if len(usable) == 1:
        name = next(iter(usable))
        url, canonical = usable[name]
        return name, url, canonical, "only usable Git remote '%s'" % name
    return None, "", "", (
        "Git checkout path (ambiguous remotes: %s; set OPTMEM_REMOTE)"
        % ", ".join(sorted(usable)) if usable else
        "Git checkout path (no usable hosted remote)")


def _path_identity(project):
    """A provisional identity before a durable project marker exists."""
    path = os.path.realpath(os.path.abspath(project))
    try:
        stat = os.stat(path)
    except OSError:
        stat = None
    if stat is not None and stat.st_ino:
        return ("filesystem:%x:%x" % (stat.st_dev, stat.st_ino),
                "filesystem identity (stable across same-filesystem moves)")
    normalized = os.path.normcase(path)
    return "path:" + normalized, "absolute path (filesystem IDs unavailable)"


def _scope_marker_path(project, checkout):
    """Keep Git markers inside .git; use one hidden file outside Git."""
    root_marker = os.path.join(os.path.abspath(project), ".optmem-scope")
    if os.path.lexists(root_marker):
        return root_marker
    if checkout:
        common = git("rev-parse", "--git-common-dir")
        if common:
            return os.path.join(os.path.abspath(common), "optmem-scope")
    return root_marker


def _read_scope_marker(path):
    if not os.path.isfile(path) or os.path.islink(path):
        return ""
    try:
        with open(path, encoding="ascii") as source:
            value = source.read(128).strip()
    except (OSError, UnicodeError):
        return ""
    match = re.fullmatch(r"optmem-scope-v1 ([0-9a-f]{32})", value)
    return "marker:" + match.group(1) if match else ""


def _scope_link_relative(d):
    """A safe store path relative to the OptMem data root, or empty."""
    root = os.path.abspath(_scope_root())
    target = os.path.abspath(d)
    try:
        relative = os.path.relpath(target, root)
        inside = (os.path.commonpath((root, target)) == root and
                  os.path.commonpath((os.path.realpath(root),
                                      os.path.realpath(target))) ==
                  os.path.realpath(root))
    except ValueError:
        return ""
    if (not inside or os.path.islink(target) or relative == os.pardir or
            relative.startswith(os.pardir + os.sep)):
        return ""
    return relative


def _write_scope_link_unlocked(identity, relative):
    """Update scope-map.json while the caller holds the data-root lock."""
    links = _read_scope_map()
    if links.get(identity) == relative:
        return
    links[identity] = relative
    encoded = (json.dumps({"version": 1, "links": links},
                          indent=2, sort_keys=True) + "\n").encode("utf-8")
    _atomic_replace(_scope_map_path(), encoded,
                    os.path.exists(_scope_map_path()))


def _ensure_scope_marker(info):
    """Atomically reserve a marker and its store during first memory use."""
    if info["kind"] != "path" or info.get("marker_identity"):
        return info
    path = info["marker_path"]
    root = _scope_root()
    os.makedirs(root, exist_ok=True)
    lock = locked(root)
    try:
        identity = _read_scope_marker(path)
        if not identity and os.path.lexists(path):
            die("Path-scope marker is invalid or unsafe: %s.\n"
                "Expected: optmem-scope-v1 followed by 32 lowercase hex digits."
                % pretty(path))
        if not identity:
            identity = "marker:" + os.urandom(16).hex()
            encoded = ("optmem-scope-v1 %s\n" %
                       identity.split(":", 1)[1]).encode("ascii")
            _atomic_replace(path, encoded, False)
        # Publish the link before another process can observe the marker.
        # The empty directory is a reservation; LOG.txt remains untouched
        # until store() completes normal validation and initialization.
        if os.path.lexists(info["store"]) and os.path.islink(info["store"]):
            die("Refusing symbolic-link project store at %s."
                % pretty(info["store"]))
        os.makedirs(info["store"], exist_ok=True)
        relative = _scope_link_relative(info["store"])
        if not relative:
            die("Refusing project store outside OptMem data root: %s."
                % pretty(info["store"]))
        _write_scope_link_unlocked(identity, relative)
    finally:
        lock.close()
    updated = dict(info)
    updated["identity"] = identity
    updated["marker_identity"] = identity
    updated["source"] = (
        ("Git checkout marker" if info["checkout"] else
         "project marker") + " (stable across directory and filesystem moves)")
    return updated


def project_scope():
    """Describe automatic project selection without creating or changing it."""
    root = _scope_root()
    checkout = git("rev-parse", "--show-toplevel")
    remote_name, remote_url, canonical, source = _remote_selection()
    warning = None
    if canonical:
        identity = canonical
        label = canonical.rsplit("/", 1)[-1]
        preferred = os.path.join(
            root, "repo-v2", "%s-%s" % (_scope_label(label),
                                        _scope_key(identity)))
        legacy = _legacy_remote_dir(root, remote_url, canonical)
        stored = _read_scope_identity(legacy) if os.path.isdir(legacy) else None
        legacy_compatible = (
            os.path.isdir(legacy) and (
                (stored is None and
                 not os.path.lexists(_scope_identity_path(legacy))) or
                _stored_identity_matches(stored, identity)))
        if os.path.isdir(preferred):
            selected, layout = preferred, "canonical"
        elif legacy_compatible:
            selected, layout = legacy, "legacy-compatible"
        else:
            selected, layout = preferred, "canonical"
            if os.path.isdir(legacy):
                owner = (stored["canonical"] if stored is not None else
                         "an unreadable identity")
                warning = ("Legacy store %s belongs to %s; using an isolated "
                           "store for %s." % (pretty(legacy), owner, identity))
        return {
            "kind": "remote", "project": identity, "identity": identity,
            "alias": safe_origin_alias(remote_url), "source": source,
            "remote_name": remote_name, "remote_url": remote_url,
            "checkout": checkout or os.getcwd(), "store": selected,
            "preferred": preferred, "legacy": legacy, "layout": layout,
            "warning": warning,
        }

    project = checkout or os.getcwd()
    if not checkout:
        source = "current directory (outside Git)"
    marker_path = _scope_marker_path(project, checkout)
    marker_identity = _read_scope_marker(marker_path)
    if os.path.lexists(marker_path) and not marker_identity:
        warning = ("Path-scope marker is invalid or unsafe: %s"
                   % pretty(marker_path))
    if marker_identity:
        identity = marker_identity
        identity_source = (
            "Git checkout marker" if checkout else "project marker")
        identity_source += " (stable across directory and filesystem moves)"
    else:
        identity, identity_source = _path_identity(project)
        identity_source += "; provisional until first memory use"
    label = os.path.basename(os.path.normpath(project)) or "project"
    preferred = os.path.join(
        root, "path-v2", "%s-%s" % (_scope_label(label), _scope_key(identity)))
    legacy = _legacy_path_dir(root, project)
    linked = _linked_scope_dir(identity)
    if linked:
        selected, layout = linked, "linked path"
    elif os.path.isdir(preferred):
        selected, layout = preferred, "filesystem identity"
    elif os.path.isdir(legacy):
        selected, layout = legacy, "legacy-compatible path"
    else:
        selected, layout = preferred, "filesystem identity"
    return {
        "kind": "path", "project": os.path.abspath(project),
        "identity": identity, "alias": os.path.abspath(project),
        "source": source + "; " + identity_source,
        "remote_name": None, "remote_url": "", "checkout": checkout,
        "store": selected, "preferred": preferred, "legacy": legacy,
        "layout": layout, "warning": warning, "marker_path": marker_path,
        "marker_identity": marker_identity,
    }


def _record_scope_link(info, d):
    """Remember where a legacy path store lives so directory moves retain it."""
    if info["kind"] != "path":
        return
    relative = _scope_link_relative(d)
    if not relative:
        return
    root = _scope_root()
    os.makedirs(root, exist_ok=True)
    lock = locked(root)
    try:
        _write_scope_link_unlocked(info["identity"], relative)
    finally:
        lock.close()


def _record_scope_identity(d, info=None):
    """Record or safely upgrade the identity claimed by a project store."""
    if SCOPE_GLOBAL or os.environ.get("MEMORY_DIR"):
        return
    info = info or project_scope()
    canonical = info["identity"]
    alias = info["alias"]
    identity_path = _scope_identity_path(d)
    current = _read_scope_identity(d)
    if current is not None:
        if not _stored_identity_matches(current, canonical):
            return
        if current["canonical"] == canonical and alias in current["aliases"]:
            _record_scope_link(info, d)
            return
    if current is None and os.path.lexists(identity_path):
        return
    lock = locked(d)
    try:
        current = _read_scope_identity(d)
        if current is None and not os.path.lexists(identity_path):
            encoded = (json.dumps({
                "version": 1,
                "canonical": canonical,
                "aliases": [alias],
            }, indent=2, sort_keys=True) + "\n").encode("utf-8")
            _atomic_replace(identity_path, encoded, False)
        elif current is not None and _stored_identity_matches(current, canonical):
            current["canonical"] = canonical
            if alias not in current["aliases"]:
                current["aliases"].append(alias)
            encoded = (json.dumps(
                current, indent=2, sort_keys=True) + "\n").encode("utf-8")
            _atomic_replace(identity_path, encoded, True)
    finally:
        lock.close()
    _record_scope_link(info, d)


def scope_dir():
    return project_scope()["store"]


def memory_dir():
    """MEMORY_DIR wins, then --global, then the project in $PWD."""
    d = os.environ.get("MEMORY_DIR")
    if d:
        return os.path.expanduser(d)
    return os.path.expanduser(GLOBAL) if SCOPE_GLOBAL else scope_dir()


def store():
    info = None
    if not os.environ.get("MEMORY_DIR") and not SCOPE_GLOBAL:
        info = project_scope()
        if info["kind"] == "path":
            info = _ensure_scope_marker(info)
        d = info["store"]
    else:
        d = memory_dir()
    # A named memory is only ever created by `memo init`: creating it IS
    # creating the identity, and that is a deliberate act. If any other
    # command created it, a typo in MEMORY_DIR would silently open an empty
    # store, and the agent would wake with no past and write a second
    # identity. A project memory is the exception: its name is read from the
    # repo, not typed, so it appears on first use.
    if not os.path.isdir(d):
        if os.environ.get("MEMORY_DIR") or SCOPE_GLOBAL:
            die("No memory at %s.\nTo create one, run: %s init\n"
                "To use an existing one, point MEMORY_DIR at it." % (d, ME))
        os.makedirs(d, exist_ok=True)
    tree = os.path.join(d, "TREE")
    if os.path.lexists(tree) and os.path.islink(tree):
        die("Refusing symbolic-link TREE directory at %s." % pretty(tree))
    os.makedirs(tree, exist_ok=True)
    p = os.path.join(d, "LOG.txt")
    if os.path.lexists(p) and os.path.islink(p):
        die("Refusing symbolic-link LOG.txt at %s." % pretty(p))
    if not os.path.exists(p):
        open(p, "a").close()
    _record_scope_identity(d, info)
    return d


def size(k, v, where=""):
    """Validate one knob, wherever it came from: the config file or argv. A
    bad knob stops every command, so the message has to say where it is
    written -- `memo config` cannot fix a file it also refuses to read."""
    if not v.isdigit() or int(v) < 1:
        die("%s%s must be a positive whole number, not '%s'." % (where, k, v))
    top = min(TREE_REC - 8, LOG_REC - 40)
    if k == "ENTRY_CHARS" and int(v) > top:
        die("%sENTRY_CHARS is at most %d: a memory has to fit the fixed-width "
            "records." % (where, top))
    return int(v)


def overrides(d):
    """The knobs this memory sets for itself, read from its `config` file."""
    out = {}
    p = os.path.join(d, "config")
    if not os.path.exists(p):
        return out
    for n, line in enumerate(open(p, encoding="utf-8"), 1):
        line = line.split("#")[0].strip()
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip().upper(), v.strip()
        where = "%s line %d: " % (pretty(p), n)
        if k not in KNOBS:
            die("%s%s is not a size. Delete the line, or name one of: %s."
                % (where, k, ", ".join(KNOBS)))
        out[k] = size(k, v, where)
    return out


def config(d):
    """Apply this memory's overrides. A knob it does not set keeps the tool's
    default, so updating the tool still changes how it behaves."""
    for k, (default, _) in KNOBS.items():
        globals()[k] = default
    for k, v in overrides(d).items():
        globals()[k] = v  # a knob's name IS the name of the global it sets


def write_config(d, over):
    """Rewrite `config`: every knob on its own line, commented out unless this
    memory overrides it."""
    out = ["# OptMem sizes for this memory. A commented line means: follow the",
           "# tool's default. Edit with `%s config NAME=VALUE`." % ME, ""]
    for k, (default, what) in KNOBS.items():
        out.append("%-2s%-12s = %-6d # %s"
                   % ("" if k in over else "# ", k, over.get(k, default), what))
    with open(os.path.join(d, "config"), "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


def log_path(d):
    return os.path.join(d, "LOG.txt")


def tree_path(d, size):
    return os.path.join(d, "TREE", str(size))


def count(path, rec):
    try:
        return os.path.getsize(path) // rec
    except FileNotFoundError:  # any other failure is real and must surface
        return 0


def log_len(d):
    return count(log_path(d), LOG_REC)


def repair(path, rec):
    """Drop a partial trailing record left by a crash. It was never
    acknowledged. Without this the next append lands at a wrong offset and
    every later record is misaligned. Callers hold the lock."""
    try:
        n = os.path.getsize(path)
    except FileNotFoundError:
        return
    if n % rec:
        with open(path, "r+b") as f:
            f.truncate(n - n % rec)


def parse(line):
    head, _, rest = line.partition(" ")
    date, _, text = rest.partition(" ")
    return int(head[1:]), date, text


def records(buf):
    """Decode a run of log records. They are sliced as BYTES and decoded one
    by one -- slicing decoded text would shift every boundary after the first
    multi-byte character."""
    return [parse(buf[i * LOG_REC:(i + 1) * LOG_REC].decode().rstrip())
            for i in range(len(buf) // LOG_REC)]


def log_slice(d, lo, hi):
    """Memories [lo,hi) in one read."""
    with open(log_path(d), "rb") as f:
        f.seek(lo * LOG_REC)
        return records(f.read((hi - lo) * LOG_REC))


def log_get(d, i):
    """(id, date, text) of memory i, in one seek."""
    return log_slice(d, i, i + 1)[0]


def log_scan(d):
    """Every memory, streamed. A search reads the whole log by nature, but it
    must not HOLD it: at a million memories that is 300 MB."""
    with open(log_path(d), "rb") as f:
        while True:
            buf = f.read(LOG_REC * 4096)
            if not buf:
                return
            for e in records(buf):
                yield e


def tree_get(d, lo, hi):
    """The summary of block [lo,hi), in one seek. None if not built yet."""
    size = hi - lo
    try:
        with open(tree_path(d, size), "rb") as f:
            f.seek((lo // size) * TREE_REC)
            rec = f.read(TREE_REC)
    except FileNotFoundError:  # not built yet; any other failure is real
        return None
    try:
        return rec.decode().rstrip() or None
    except UnicodeDecodeError:
        die("The summary of #%d-%d is corrupt. Run: %s resummarize %d-%d"
            % (lo, hi - 1, ME, lo, hi - 1))


def pad(text, rec):
    b = text.encode()
    if len(b) > rec - 1:
        die("Too long: %d bytes. The record holds %d." % (len(b), rec - 1))
    return b + b" " * (rec - 1 - len(b)) + b"\n"


def locked(d):
    # Never truncate the shared lock file while another process holds it.
    lock = open(os.path.join(d, ".lock"), "a+b")
    if fcntl is not None:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return lock

    # msvcrt locks a byte range from the current file position. Anchor every
    # process at byte zero and retry non-blocking acquisition with a real
    # 30-second deadline.
    import msvcrt
    import time
    deadline, delay = time.monotonic() + 30.0, 0.01
    while True:
        try:
            lock.seek(0)
            msvcrt.locking(lock.fileno(), msvcrt.LK_NBLCK, 1)
            break
        except OSError:
            if time.monotonic() >= deadline:
                lock.close()
                raise
            time.sleep(delay)
            delay = min(delay * 1.5, 0.25)

    original_close = lock.close

    def close():
        try:
            lock.seek(0)
            msvcrt.locking(lock.fileno(), msvcrt.LK_UNLCK, 1)
        finally:
            original_close()

    lock.close = close
    return lock


def log_append(d, items):
    """Append memories, items = [(date, text)]. The only way LOG.txt ever
    changes. Ids are assigned INSIDE the lock: two sessions noting at the same
    moment must not be handed the same id. Returns the first id used."""
    lock = locked(d)
    try:
        repair(log_path(d), LOG_REC)
        base = log_len(d)
        with open(log_path(d), "ab") as f:
            for k, (date, text) in enumerate(items):
                f.write(pad("#%d %s %s" % (base + k, date, text), LOG_REC))
            f.flush()
            os.fsync(f.fileno())
        return base
    finally:
        lock.close()


def log_import_empty(d, items):
    """Append a portable history iff the store is still empty under lock."""
    lock = locked(d)
    try:
        repair(log_path(d), LOG_REC)
        if log_len(d):
            return False
        with open(log_path(d), "ab") as f:
            for ident, (date, text) in enumerate(items):
                f.write(pad("#%d %s %s" % (ident, date, text), LOG_REC))
            f.flush()
            os.fsync(f.fileno())
        return True
    finally:
        lock.close()


def log_redact(d, ident):
    """Replace one payload in place while preserving its ID and date."""
    lock = locked(d)
    try:
        repair(log_path(d), LOG_REC)
        if ident >= log_len(d):
            return None
        old_ident, date, text = log_get(d, ident)
        replacement = "[REDACTED BY USER]"
        if text == replacement:
            return old_ident, date, text, False
        with open(log_path(d), "r+b") as f:
            f.seek(ident * LOG_REC)
            f.write(pad("#%d %s %s" % (ident, date, replacement), LOG_REC))
            f.flush()
            os.fsync(f.fileno())
        return old_ident, date, text, True
    finally:
        lock.close()


def tree_put(d, lo, hi, text):
    """Write block [lo,hi). Blocks are built in order, so this only ever
    appends one record to one level file."""
    size = hi - lo
    lock = locked(d)
    try:
        p = tree_path(d, size)
        repair(p, TREE_REC)
        if count(p, TREE_REC) != lo // size:
            return False
        with open(p, "ab") as f:
            f.write(pad(text, TREE_REC))
            f.flush()
            os.fsync(f.fileno())
        return True
    finally:
        lock.close()


def tree_put_batch(d, blocks):
    """Atomically append a validated run of summaries at one tree level."""
    if not blocks:
        return True
    size = blocks[0][1] - blocks[0][0]
    lock = locked(d)
    try:
        p = tree_path(d, size)
        repair(p, TREE_REC)
        have = count(p, TREE_REC)
        expected = [(i * size, (i + 1) * size)
                    for i in range(have, have + len(blocks))]
        if [(lo, hi) for lo, hi, _ in blocks] != expected:
            return False
        payload = b"".join(pad(text, TREE_REC) for _, _, text in blocks)
        with open(p, "ab") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        return True
    finally:
        lock.close()


def tree_drop(d, lo, hi):
    """Forget block [lo,hi) and every block built from it, by truncating each
    level back to that point. Later blocks at those levels go too and are
    rebuilt; the log is never touched, so nothing is lost."""
    gone, size = [], hi - lo
    lock = locked(d)
    try:
        while size <= log_len(d):
            p, k = tree_path(d, size), lo // size
            n = count(p, TREE_REC)
            if n > k:
                gone += [(i * size, (i + 1) * size) for i in range(k, n)]
                with open(p, "r+b") as f:
                    f.truncate(k * TREE_REC)
            size *= 2
        return gone
    finally:
        lock.close()


def tree_invalidate_memory(d, ident):
    """Remove every existing summary that could contain one raw memory."""
    gone = []
    lock = locked(d)
    try:
        root = os.path.join(d, "TREE")
        if os.path.islink(root):
            raise OSError("refusing symbolic-link TREE directory")
        for name in sorted(os.listdir(root), key=lambda item: (
                int(item) if item.isdigit() else sys.maxsize)):
            if not name.isdigit():
                continue
            size = int(name)
            if size < 2 or size & (size - 1):
                continue
            path, index = tree_path(d, size), ident // size
            if os.path.islink(path):
                raise OSError("refusing symbolic-link tree level %s" % name)
            records_ = count(path, TREE_REC)
            if records_ > index:
                gone.extend((item * size, (item + 1) * size)
                            for item in range(index, records_))
                with open(path, "r+b") as output:
                    output.truncate(index * TREE_REC)
                    output.flush()
                    os.fsync(output.fileno())
        return gone
    finally:
        lock.close()


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def plural(n, word):
    if n == 1:
        return "1 " + word
    if word.endswith("y"):
        word = word[:-1] + "ie"
    elif word.endswith(("s", "h", "x")):
        word += "e"
    return "%d %ss" % (n, word)


def block_id(s):
    """Parse `<lo>-<hi>` as wake and the nap prompts print it: inclusive at
    both ends, and a real block -- an aligned power-of-two range. Without the
    shape check, `4-5` and `5-6` read the same record."""
    m = re.fullmatch(r"(\d+)-(\d+)", s)
    if not m:
        die("'%s' is not a block id. Copy it from the prompt." % s)
    lo, hi = int(m.group(1)), int(m.group(2)) + 1
    n = hi - lo
    if n < 2 or n & (n - 1) or lo % n:
        die("%s is not a block. Copy the id printed by wake, like 16-31." % s)
    return lo, hi


def check(text):
    text = text.strip()
    if not text:
        die("Empty. A memory is one line of text.")
    if "\n" in text or "\r" in text:
        die("%d lines. A memory is one line: merge them, or note them "
            "separately." % (text.count("\n") + 1))
    n = len(text.encode())
    if n > ENTRY_CHARS:
        die("Too long: %d bytes, limit %d. Accented characters cost 2 bytes. "
            "Compress it further." % (n, ENTRY_CHARS))
    return text


def memory_id(value):
    """Parse a user-facing stable memory ID, accepting either 42 or #42."""
    match = re.fullmatch(r"#?(\d+)", value)
    if not match:
        die("'%s' is not a memory ID. Use a number such as 42 or #42." % value)
    return int(match.group(1))


def require_memory(d, value):
    ident = memory_id(value)
    total = log_len(d)
    if ident >= total:
        die("No memory #%d. This store contains %s, #%d to #%d."
            % (ident, plural(total, "memory"), 0, total - 1)
            if total else
            "No memory #%d. This store is empty." % ident)
    return ident


_LIFECYCLE_REF = re.compile(r"^(Amends|Retracts) #(\d+):\s+")


def _append_lifecycle(d, action, target, text):
    ident = require_memory(d, target)
    replacement = check(text)
    full = check("%s #%d: %s" % (action, ident, replacement))
    created = log_append(d, [(datetime.date.today().isoformat(), full)])
    print("%s #%d with #%d." % (
        "Amended" if action == "Amends" else "Retracted", ident, created))
    nap = next_nap(d, created + 1)
    if nap:
        print("\n" + nap)


# ---------------------------------------------------------------- naps

def pending(d, T, limit=None):
    """Blocks that can be built and have not been, smallest first. Each level
    file holds a dense prefix, so its length says exactly how far that level
    got: this costs one stat per level, never a scan."""
    todo, size = [], 2
    while size <= T:
        have = count(tree_path(d, size), TREE_REC)
        for k in range(have, T // size):
            todo.append((k * size, (k + 1) * size))
            if limit and len(todo) >= limit:
                return todo
        size *= 2
    return todo


def pending_count(d, T):
    """How many blocks pending() would list, without listing them. A level can
    hold MORE blocks than T needs -- T is a snapshot, and memories keep
    arriving while an agent reads -- so each level is clamped at zero."""
    n, size = 0, 2
    while size <= T:
        n += max(0, T // size - count(tree_path(d, size), TREE_REC))
        size *= 2
    return n


def nap_prompt(d, lo, hi, left):
    if hi - lo <= RAW_MAX:
        body = "\n".join("  #%d %s %s" % e for e in log_slice(d, lo, hi))
    else:
        mid, halves = (lo + hi) // 2, []
        for a, b in ((lo, mid), (mid, hi)):
            s = tree_get(d, a, b)
            if s is None:
                # pending() lists a block only after its halves settled, so
                # a missing half is a blank record -- a corrupt write. Drop
                # it and the next nap rebuilds it.
                die("The summary of #%d-%d is blank. Run: %s resummarize %d-%d"
                    % (a, b - 1, ME, a, b - 1))
            halves.append("  #%d-%d %s" % (a, b - 1, s))
        body = "\n".join(halves)
    tail = "" if not left else "\n%s after this one." % (
        "1 compression remains" if left == 1 else
        "%d compressions remain" % left)
    return ("Compress memories #%d-%d into one line of at most %d UTF-8 bytes.\n"
            "Make it a self-contained retrieval cue. Preserve durable "
            "decisions, outcomes, constraints, causal links, and useful "
            "failure reasons. Drop transient status, incidental chronology, and "
            "repetition. Use specific names; invent nothing and never imply "
            "a link between unrelated facts. Later amendments, corrections, "
            "and retractions override the records they reference: preserve the "
            "final outcome, and keep earlier information only when its history "
            "or failure reason remains useful.\n\n"
            "%s\n%s\n"
            "Run: %s nap %d-%d \"<your line>\""
            % (lo, hi - 1, ENTRY_CHARS, body, tail, ME, lo, hi - 1))


def next_nap(d, T):
    todo = pending(d, T, limit=1)
    if not todo:
        return None
    lo, hi = todo[0]
    return nap_prompt(d, lo, hi, pending_count(d, T) - 1)


def batch_pending(d, T, limit):
    """A contiguous run from the smallest pending level.

    These jobs are independent and can be summarized together. Keeping one
    level per batch also lets --apply commit the whole batch in one fsync.
    """
    size = 2
    while size <= T:
        have, needed = count(tree_path(d, size), TREE_REC), T // size
        if have < needed:
            return [(index * size, (index + 1) * size)
                    for index in range(have, min(needed, have + limit))]
        size *= 2
    return []


def batch_nap_prompt(d, jobs, left):
    lines = [
        "Compress each range independently into one line of at most %d UTF-8 "
        "bytes." % ENTRY_CHARS,
        "Preserve durable decisions, outcomes, constraints, causal links, and "
        "useful failure reasons. Later amendments, corrections, and "
        "retractions override what they reference. Drop transient status and "
        "repetition; invent nothing.",
        "",
    ]
    for lo, hi in jobs:
        lines.append("%d-%d:" % (lo, hi - 1))
        if hi - lo <= RAW_MAX:
            lines.extend("  #%d %s %s" % entry
                         for entry in log_slice(d, lo, hi))
        else:
            mid = (lo + hi) // 2
            for a, b in ((lo, mid), (mid, hi)):
                summary = tree_get(d, a, b)
                if summary is None:
                    die("The summary of #%d-%d is blank. Run: "
                        "%s resummarize %d-%d"
                        % (a, b - 1, ME, a, b - 1))
                lines.append("  #%d-%d %s" % (a, b - 1, summary))
        lines.append("")
    lines.extend([
        "Write a UTF-8 file with one TAB-separated result per line:",
        "  <range><TAB><one-line summary>",
        "Then run: %s nap --apply <file>" % ME,
    ])
    if left:
        lines.append("%s will remain after this batch." %
                     plural(left, "compression"))
    return "\n".join(lines)


def fitted_batch_prompt(d, T, requested):
    jobs = batch_pending(d, T, requested)
    total = pending_count(d, T)
    while jobs:
        prompt = batch_nap_prompt(d, jobs, total - len(jobs))
        if (len(prompt.encode("utf-8")) <= PART_CHARS and
                len(prompt.splitlines()) <= PART_LINES):
            return jobs, prompt
        jobs.pop()
    return [], None


